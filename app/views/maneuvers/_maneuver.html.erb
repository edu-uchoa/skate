<span class="step-indicator">NÓ <%= maneuver.position %> • MANOBRA</span>
<h2 class="screen-title" style="font-family: 'Outfit', sans-serif;"><%= maneuver.label.titleize %></h2>

<div class="video-container" style="position: relative; width: 100%; height: 140px; border-radius: 10px; overflow: hidden; border: 1px solid #343538; margin-bottom: 10px; box-shadow: 3px 3px 0 #121316;">
  <% if maneuver.video_url.present? %>
    <video style="width: 100%; height: 100%; object-fit: cover;" controls preload="metadata" src="<%= maneuver.video_url %>"></video>
  <% else %>
    <img src="<%= asset_path('skater_hero.jpg') %>" alt="Demonstração" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.6;">
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 50px; height: 50px; background: #ffb800; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
      <span class="material-symbols-outlined" style="font-size: 32px; color: black;">play_arrow</span>
    </div>
  <% end %>
</div>

<% if maneuver.why_now.present? %>
  <div class="sub-headline-card" style="border-left: 4px solid #ffb800; transform: none; background: #1a1b20; padding: 8px 10px; margin-bottom: 8px;">
    <span style="font-size: 10px; font-weight: 800; color: #ffb800; text-transform: uppercase; display: block; margin-bottom: 2px;">🎯 Por que agora?</span>
    <p style="font-size: 11px; color: #d5c4ab; line-height: 1.35; font-family: 'Inter', sans-serif;"><%= maneuver.why_now %></p>
  </div>
<% end %>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 10px;">
  <div style="background: #1a1b20; border: 1px solid #343538; border-radius: 8px; padding: 10px;">
    <div style="display: flex; align-items: center; gap: 6px; font-size: 9px; font-weight: 800; color: #888; text-transform: uppercase; margin-bottom: 4px;">
      <span class="material-symbols-outlined" style="font-size: 14px;">fitness_center</span> Dificuldade
    </div>
    <span style="font-size: 13px; font-weight: 800; color: #e3e2e6;"><%= maneuver.difficulty&.titleize || "—" %></span>
  </div>
  <div style="background: #1a1b20; border: 1px solid #343538; border-radius: 8px; padding: 10px;">
    <div style="display: flex; align-items: center; gap: 6px; font-size: 9px; font-weight: 800; color: #888; text-transform: uppercase; margin-bottom: 4px;">
      <span class="material-symbols-outlined" style="font-size: 14px;">timer</span> Tempo médio
    </div>
    <span style="font-size: 13px; font-weight: 800; color: #e3e2e6;"><%= maneuver.average_time || "—" %></span>
  </div>
</div>

<% if locked %>
  <div style="background: #1a1b20; border: 1px solid #343538; border-radius: 8px; padding: 12px; text-align: center;">
    <span class="material-symbols-outlined" style="font-size: 24px; color: #666;">lock</span>
    <p style="font-size: 12px; color: #d5c4ab; margin-top: 6px;">
      Este nó ainda está bloqueado<%= ". Conclua #{maneuver.prerequisite.label} antes." if maneuver.prerequisite %>
    </p>
  </div>
<% else %>
  <div style="margin-top: auto; display: flex; flex-direction: column; gap: 8px;">
    <%= link_to new_maneuver_training_session_path(maneuver), class: "tactile-btn-primary", style: "display: flex; justify-content: center; align-items: center; gap: 6px; text-decoration: none; font-family: 'Outfit', sans-serif;" do %>
      <span class="material-symbols-outlined">skateboarding</span>
      <span style="font-weight: 800;">Treinar essa manobra</span>
    <% end %>
    <%= link_to new_schedule_path(maneuver_slug: maneuver.slug), class: "secondary-link-btn", style: "text-align: center; display: block;" do %>
      Agendar para depois
    <% end %>
  </div>
<% end %>
