<% content_for :section, "Avatar" %>

<div style="position: relative; width: 100%; height: 150px; background: linear-gradient(to bottom, #1f1f23, #0d0e11); border-radius: 8px; border: 1px solid #343538; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; overflow: hidden; box-shadow: 3px 3px 0 #121316;">
  <div style="width: 100px; height: 100px; border-radius: 50%; border: 3px solid #ffb800; overflow: hidden; box-shadow: 0 0 16px rgba(255,184,0,0.35); background: #121316;">
    <img src="<%= asset_path 'skater_avatar_head.png' %>" alt="Avatar Skatista" style="width: 100%; height: 100%; object-fit: cover;">
  </div>
  <div class="version-badge" style="top: 6px; left: 6px; background: #6cff82; color: #002106; font-weight: 800; font-size: 9px;">DROP OFICIAL</div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 10px;">
  <button class="tactile-btn-primary" style="padding: 6px; font-size: 12px; margin: 0; font-family: 'Outfit', sans-serif;">
    🧍‍♂️ Skatista Masc
  </button>
  <button class="tactile-btn-primary" style="padding: 6px; font-size: 12px; margin: 0; background: #1f1f23; color: #e3e2e6; box-shadow: 0 4px 0 #121316; font-family: 'Outfit', sans-serif;">
    🧍‍♀️ Skatista Fem
  </button>
</div>

<div style="display: flex; gap: 10px; border-bottom: 1px solid #343538; padding-bottom: 4px; margin-bottom: 8px; font-size: 11px; font-weight: 800; text-transform: uppercase;">
  <span style="color: #ffb800; border-bottom: 2px solid #ffb800; padding-bottom: 2px;">Roupas</span>
  <span style="color: #9e8f78;">Cabelo</span>
  <span style="color: #9e8f78;">Acessórios</span>
  <%= link_to "Deck 🛹", deck_path, style: "color: #9e8f78; cursor: pointer; text-decoration: none;" %>
</div>

<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 12px; font-family: 'Inter', sans-serif;">
  <div class="option-card selected" style="padding: 6px; text-align: center; margin: 0;">
    <span class="material-symbols-outlined" style="color: #ffb800; font-size: 22px;">checkroom</span>
    <span style="font-size: 9px; font-weight: bold; display: block;">Hoodie Preto</span>
    <span style="font-size: 8px; color: #30D158; font-weight: bold;">EQUIPADO</span>
  </div>

  <div class="option-card" style="padding: 6px; text-align: center; margin: 0;">
    <span class="material-symbols-outlined" style="color: #9e8f78; font-size: 22px;">apparel</span>
    <span style="font-size: 9px; font-weight: bold; display: block;">Raglan Street</span>
    <span style="font-size: 8px; color: #9e8f78;">GRÁTIS</span>
  </div>

  <div class="option-card" style="padding: 6px; text-align: center; margin: 0; opacity: 0.6;">
    <span class="material-symbols-outlined" style="color: #514532; font-size: 22px;">lock</span>
    <span style="font-size: 9px; font-weight: bold; display: block;">Over Street</span>
    <span style="font-size: 8px; color: #ffb800; font-weight: bold;">150 🪙</span>
  </div>
</div>

<div style="margin-top: auto; padding-top: 6px; padding-bottom: 24px;">
  <%= link_to deck_path, class: "tactile-btn-primary", style: "display: flex; justify-content: center; align-items: center; gap: 6px; text-decoration: none; font-family: 'Outfit', sans-serif;" do %>
    <span style="font-weight: 800;">Customizar Skate (Deck Builder)</span>
    <span class="material-symbols-outlined">arrow_forward</span>
  <% end %>
</div>
