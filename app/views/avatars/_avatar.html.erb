<%# Avatar de skatista (Avatar), no estilo dos jogos de skate de hoje: proporção de
    gente de verdade, roupa larga e luz vindo da esquerda. Não é 3D, mas cada parte
    tem sombra e brilho em degradê por cima da cor (url(#cyl-...), #fall-..., #ao-...)
    para ganhar volume, e o skate fica na mão, como nos jogos.
    locals: look (Avatar), uid (único na página), deck (Deck, opcional: as rodas e os
    trucks do skate na mão saem dele), crop (true: só do peito para cima, no topo do
    Perfil) e editable (true no editor: vão todas as opções e a prévia troca na hora).
    O lado direito do corpo é o esquerdo espelhado (avatar_mirror / avatar_both). %>
<% editable = local_assigns.fetch(:editable, false) %>
<% deck     = local_assigns[:deck] %>
<% layer    = ->(part, option, &block) { customizer_layer(look, part, option, editable, &block) } %>
<% u        = uid %>
<%
  # A cabeça é desenhada maior e encolhida em volta do queixo: proporção de gente.
  head = "translate(100 84) scale(0.92) translate(-100 -84)"

  arm      = "M60 104 C54 116 51 132 50 148 C49 164 48 180 47.5 196 L58.5 197 C59 182 60 166 61 150 C62 136 64 122 68 108 Z"
  hand     = "M46.5 194 C44.6 200 44.4 208 45.6 214 C46.8 219.6 51 223 55.4 221.6 C58.8 220.4 60.2 214 60.2 206.4 C60.2 201 59.8 197.4 59.2 194 Z"
  fingers  = "M48.6 214.6 C49.6 217.4 51.6 218.8 53.6 218.6 M52.8 215.4 C53.8 217.6 55.6 218.6 57.4 217.8 M59.6 200 C61.4 203 61.6 207.6 59.8 211"
  sleeve   = "M58 101 C51 105 47 116 45.4 132 C44 150 43.2 170 42.8 188 L58.8 190 C59.4 172 60.4 154 61.8 138 C62.8 126 64.4 114 67 105 Z"
  cuff     = "M42.6 187 L58.9 189 L58.6 198 L42.3 196.6 Z"
  sweat    = "M74 93 C82 90 91 89 100 89 C109 89 118 90 126 93 C134 95 140 98 143 103 C145 125 144 152 141 181 L140 190 L60 190 L59 181 C56 152 55 125 57 103 C60 98 66 95 74 93 Z"
  hem      = "M59.3 181 L140.7 181 L140.4 191 L59.6 191 Z"
  collar   = "M87 91.5 C91 97.6 109 97.6 113 91.5 C112.2 89 110.6 88.4 108.6 88.8 C105.6 92.6 94.4 92.6 91.4 88.8 C89.4 88.4 87.8 89 87 91.5 Z"
  tee      = "M74 93 C82 90 91 89 100 89 C109 89 118 90 126 93 C136 96 143.5 100 146.5 106 C148.6 118 150 130 151 142 L139.6 145 C140.4 162 141.4 180 142.4 198 L57.6 198 C58.6 180 59.6 162 60.4 145 L49 142 C50 130 51.4 118 53.5 106 C56.5 100 64 96 74 93 Z"
  tee_arm  = "M53.5 106 C56.5 100 64 96 72 94 C68 110 64 126 61.6 145 L49 142 C50 130 51.4 118 53.5 106 Z"
  sweat_folds = "M70 152 C77 156 85 157 91 155 M110 157 C117 158 124 156 130 152 M46.2 148 C50 150 55 150 60 147 M45.4 164 C50 166.6 55 166.6 59.6 163.6 M44.6 178 C49 180 54.4 180 59 177.6 M153.8 148 C150 150 145 150 140 147 M154.6 164 C150 166.6 145 166.6 140.4 163.6"
  tee_folds   = "M64 160 C72 166 84 168 95 164 M120 174 C127 172 133 168 137 161 M66 186 C76 190 90 190 100 188"
  pants    = "M66 186 L134 186 C137 232 140 282 141 332 C132 323 112 323 104 333 C103 292 102 252 100 218 C98 252 97 292 96 333 C88 323 68 323 59 332 C60 282 63 232 66 186 Z"
  leg      = "M66 186 L100 186 L100 218 C98 252 97 292 96 333 C88 323 68 323 59 332 C60 282 63 232 66 186 Z"
  shorts   = "M66 186 L134 186 C136.5 214 139 242 141 268 L104 269 C103 252 102 236 100 218 C98 236 97 252 96 269 L59 268 C61 242 63.5 214 66 186 Z"
  short_leg = "M66 186 L100 186 L100 218 C98 236 97 252 96 269 L59 268 C61 242 63.5 214 66 186 Z"
  shin     = "M64.4 262 C64.8 282 66.4 304 68.2 331 L91.8 331 C92.6 304 93.8 282 94.6 262 Z"
  pant_folds = "M96 226 C90 236 84 244 76 250 M94 262 C88 270 80 276 70 280 M61 306 C72 310.6 84 310.6 96.4 306.6 M60.6 314.6 C72 319 84 319 96.2 315.2 M80 222 C79 252 78.6 280 78.4 300"
  waistband = "M66 186 L134 186 L134.3 193 L65.7 193 Z"
  loops    = "M72 185 h2.4 v9 h-2.4 Z M90.6 185 h2.4 v9 h-2.4 Z M107 185 h2.4 v9 h-2.4 Z M125.6 185 h2.4 v9 h-2.4 Z"
  fly      = "M100 193 L100 216 M100 194 C103.6 194 104.4 196 104.4 199 L104.4 209 C104.4 212 102.6 214.6 100 216"
  pockets  = "M67 196 C72 200 77 201 82 198 M133 196 C128 200 123 201 118 198"
  sock     = "M66.8 290 L93.2 290 L92.4 331 L67.8 331 Z"

  # Tênis visto de frente (lado esquerdo; o direito é espelhado).
  sole     = "M62 340.5 C62 338.4 63.8 337 66 337 L92 337 C94.2 337 96 338.4 96 340.5 L96 344.2 C96 346.8 93.6 348.4 90.4 348.4 L67.6 348.4 C64.4 348.4 62 346.8 62 344.2 Z"
  upper    = "M64.6 339 C63.8 329.6 69.6 322 79 322 C88.4 322 94.2 329.6 93.4 339 Z"
  toe      = "M66.4 339 C66.4 333.6 71.6 330.6 79 330.6 C86.4 330.6 91.6 333.6 91.6 339 Z"
  tongue   = "M73.6 322.6 L84.4 322.6 L83.4 332.4 L74.6 332.4 Z"
  laces    = "M74.4 325 L83.6 325 M74.8 328 L83.2 328 M75.2 331 L82.8 331"
  stripe   = "M65.6 335 C66.8 330.6 69 327 72.2 324.8"
  ridges   = "M70 333.4 L70.6 338.6 M74.4 331.8 L74.8 338.6 M79 331.2 L79 338.6 M83.6 331.8 L83.2 338.6 M88 333.4 L87.4 338.6"
  shoe_style = {
    "corrida"        => { toe: "#2e2b2a", laces: "#2e2b2a", accent: "#d64545" },
    "classico"       => { toe: "#ecebe6", laces: "#ecebe6", ridges: true },
    "camurca"        => { toe: "#57402f", laces: "#2b1d16", stripe: "#ecebe6" },
    "preto-caramelo" => { toe: "#2b2b30", laces: "#2b2b30", stitch: true },
    "branco"         => { toe: "#f6f4ef", laces: "#f7f6f2" }
  }

  # Rosto (lado esquerdo do rosto de quem olha; o outro é espelhado).
  face_m   = "M100 22 C112 22 120 30 120.5 44 C121 54 120 62 117.5 69 C114 77 107 82 100 82 C93 82 86 77 82.5 69 C80 62 79 54 79.5 44 C80 30 88 22 100 22 Z"
  face_f   = "M100 23 C111.5 23 119 31 119.5 44 C120 54 118.5 62 115.5 69 C112 76 106 80.5 100 80.5 C94 80.5 88 76 84.5 69 C81.5 62 80 54 80.5 44 C81 31 88.5 23 100 23 Z"
  ear      = "M81 46.6 C77.8 45.8 76.2 49 76.6 53 C77 57.2 78.6 60.2 81.4 60 Z"
  eye      = "M86.5 50.6 C88 48.3 90 47.6 91.8 47.7 C93.8 47.8 95.5 48.9 96.6 50.6 C95 52.2 93.4 52.9 91.6 52.9 C89.6 52.9 88 52.2 86.5 50.6 Z"
  lid      = "M86.2 50.6 C88 47.8 90.2 47.2 92 47.3 C94 47.4 95.8 48.6 96.9 50.4"
  crease   = "M87 47.2 C89.4 45.4 93.6 45.4 96.2 47"
  brow_m   = "M85.2 45.2 C88 43.4 92 43 96.4 44.4"
  brow_f   = "M85.8 44.8 C88.6 42.6 92.4 42.4 96.2 43.8"
  mustache = "M93 66.6 C96 64.8 99 65.4 100 66.2 C101 65.4 104 64.8 107 66.6 C105 68.2 102 67.8 100 67.6 C98 67.8 95 68.2 93 66.6 Z"
  crown    = "M79 42 C78.4 26 88 17.6 100 17.6 C112 17.6 121.6 26 121 42 C116 34.6 108.6 30.6 100 30.6 C91.4 30.6 84 34.6 79 42 Z"
  cap      = "M77.6 43 C77 24.6 87 14.6 100 14.6 C113 14.6 123 24.6 122.4 43 C116.6 38.6 108.6 36.4 100 36.4 C91.4 36.4 83.4 38.6 77.6 43 Z"
  helmet   = "M73.6 45.6 C71.6 21 84.6 7.6 100 7.6 C115.4 7.6 128.4 21 126.4 45.6 C120 41.2 110.6 38.6 100 38.6 C89.4 38.6 80 41.2 73.6 45.6 Z"
  loc      = ->(x1, y1, x2, y2, bend) { "M#{x1} #{y1} C#{x1 + bend} #{y1 + (y2 - y1) / 3.0} #{x2 - bend} #{y1 + (y2 - y1) * 2 / 3.0} #{x2} #{y2}" }
%>
<svg class="avatar" viewBox="<%= local_assigns[:crop] ? "50 8 100 140" : "0 0 200 360" %>" role="img" aria-label="Avatar de skatista"
     data-base="<%= look[:base] %>" data-head="<%= look[:head] %>" style="<%= [ look.css_variables, deck&.css_variables ].compact.join(" ") %>"
     <%= tag.attributes(data: { customizer_target: "preview" }) if editable %>>
  <defs>
    <%# Sombra de volume: escura nas bordas, um brilho do lado da luz (esquerda). %>
    <linearGradient id="cyl-<%= u %>" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#000" stop-opacity="0.42" />
      <stop offset="0.18" stop-color="#000" stop-opacity="0.1" />
      <stop offset="0.38" stop-color="#fff" stop-opacity="0.13" />
      <stop offset="0.6" stop-color="#000" stop-opacity="0" />
      <stop offset="0.86" stop-color="#000" stop-opacity="0.26" />
      <stop offset="1" stop-color="#000" stop-opacity="0.5" />
    </linearGradient>
    <linearGradient id="fall-<%= u %>" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.08" />
      <stop offset="0.6" stop-color="#000" stop-opacity="0" />
      <stop offset="1" stop-color="#000" stop-opacity="0.3" />
    </linearGradient>
    <%# Sombra de contato: onde uma parte encosta na outra (barra da blusa, queixo). %>
    <linearGradient id="ao-<%= u %>" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#000" stop-opacity="0.5" />
      <stop offset="1" stop-color="#000" stop-opacity="0" />
    </linearGradient>
    <radialGradient id="face-<%= u %>" cx="0.42" cy="0.38" r="0.7">
      <stop offset="0" stop-color="#fff" stop-opacity="0.14" />
      <stop offset="0.5" stop-color="#fff" stop-opacity="0" />
      <stop offset="1" stop-color="#000" stop-opacity="0.36" />
    </radialGradient>
    <radialGradient id="gloss-<%= u %>" cx="0.34" cy="0.24" r="0.85">
      <stop offset="0" stop-color="#fff" stop-opacity="0.6" />
      <stop offset="0.3" stop-color="#fff" stop-opacity="0" />
      <stop offset="1" stop-color="#000" stop-opacity="0.38" />
    </radialGradient>
    <radialGradient id="floor-<%= u %>">
      <stop offset="0" stop-color="#000" stop-opacity="0.6" />
      <stop offset="1" stop-color="#000" stop-opacity="0" />
    </radialGradient>
    <pattern id="rib-<%= u %>" width="2.4" height="10" patternUnits="userSpaceOnUse">
      <rect width="1.1" height="10" fill="#000" opacity="0.22" />
    </pattern>
    <pattern id="curl-<%= u %>" width="5" height="5" patternUnits="userSpaceOnUse">
      <circle cx="2.5" cy="2.5" r="1.7" fill="#000" opacity="0.2" />
    </pattern>
    <pattern id="plaid-<%= u %>" width="18" height="18" patternUnits="userSpaceOnUse">
      <rect class="av-top" width="18" height="18" />
      <rect y="6" width="18" height="6" fill="#000" opacity="0.28" />
      <rect x="6" width="6" height="18" fill="#000" opacity="0.28" />
      <rect y="14" width="18" height="1.2" fill="#fff" opacity="0.4" />
      <rect x="15" width="1.2" height="18" fill="#fff" opacity="0.25" />
    </pattern>
    <pattern id="camo-<%= u %>" width="40" height="40" patternUnits="userSpaceOnUse">
      <rect width="40" height="40" fill="#b5ab84" />
      <path d="M2 6 C8 2 16 4 18 10 C20 16 12 20 6 18 C0 16 -2 10 2 6 Z M24 22 C30 18 38 22 38 28 C38 34 30 36 26 32 C22 30 20 26 24 22 Z" fill="#7f7b54" />
      <path d="M14 26 C18 24 22 28 20 32 C18 36 12 34 12 30 Z M28 4 C32 2 36 6 34 10 C32 12 28 10 28 4 Z" fill="#5b5a3b" />
      <path d="M4 30 C8 28 12 32 10 36 C8 38 4 36 4 30 Z M30 12 C34 10 40 14 38 18 C36 20 30 18 30 12 Z" fill="#9a8c63" />
    </pattern>
  </defs>

  <%# Sombra no chão %>
  <ellipse cx="104" cy="347" rx="62" ry="7.5" fill="url(#floor-<%= u %>)" />

  <%# 1. Cabelo de trás (atrás do corpo) %>
  <g transform="<%= head %>">
    <%= layer.(:hair, "ondulado") do %>
      <path class="av-hair" d="M78.6 36 C74.6 52 73 70 74 88 C75 96 79 100 83.6 98.6 C85.6 101.6 89 102 91.4 99 L108.6 99 C111 102 114.4 101.6 116.4 98.6 C121 100 125 96 126 88 C127 70 125.4 52 121.4 36 Z" />
      <path d="M78.6 36 C74.6 52 73 70 74 88 C75 96 79 100 83.6 98.6 C85.6 101.6 89 102 91.4 99 L108.6 99 C111 102 114.4 101.6 116.4 98.6 C121 100 125 96 126 88 C127 70 125.4 52 121.4 36 Z" fill="#000" opacity="0.35" />
    <% end %>
    <%= layer.(:hair, "dreads") do %>
      <path class="av-hair" d="M78 36 C73.6 54 72 76 73 102 L127 102 C128 76 126.4 54 122 36 Z" />
      <path d="M78 36 C73.6 54 72 76 73 102 L127 102 C128 76 126.4 54 122 36 Z" fill="#000" opacity="0.4" />
    <% end %>
    <%= layer.(:hair, "longo") do %>
      <path class="av-hair" d="M78.6 36 C74 60 72.4 96 73 132 C80 136 90 136 96 132 L104 132 C110 136 120 136 127 132 C127.6 96 126 60 121.4 36 Z" />
      <path d="M78.6 36 C74 60 72.4 96 73 132 C80 136 90 136 96 132 L104 132 C110 136 120 136 127 132 C127.6 96 126 60 121.4 36 Z" fill="#000" opacity="0.38" />
    <% end %>
    <%= layer.(:hair, "trancas") do %>
      <path class="av-hair" d="M79 38 C76 52 76 66 78 76 L122 76 C124 66 124 52 121 38 Z" />
    <% end %>
    <%= layer.(:hair, "cacheado") do %>
      <path class="av-hair" d="M79 40 C76 54 77 66 80 72 L120 72 C123 66 124 54 121 40 Z" />
    <% end %>
    <%= layer.(:hair, "black-power") do %>
      <circle class="av-hair hair-top" cx="100" cy="38" r="34" />
      <circle class="hair-top" cx="100" cy="38" r="34" fill="url(#curl-<%= u %>)" />
      <path class="av-hair" d="M76 42 C71 54 72 68 79 76 L121 76 C128 68 129 54 124 42 Z" />
    <% end %>
  </g>

  <%# 2. Pernas: canela, meia, tênis e calça (a barra cai por cima do tênis) %>
  <g class="av-legs">
    <path class="av-skin" d="<%= avatar_both(shin) %>" />
    <path d="<%= shin %>" fill="url(#cyl-<%= u %>)" /><path d="<%= avatar_mirror(shin) %>" fill="url(#cyl-<%= u %>)" />
    <%= layer.(:vitiligo, true) do %>
      <path class="av-vitiligo" d="M120 276 C123 273.6 127 274.6 127.6 278 C128 281.6 124.8 284.4 121.8 283.4 C119.6 282.6 118.8 278.4 120 276 Z" />
    <% end %>

    <% { "branca" => "av-sock", "listrada" => "av-sock", "preta" => "av-sock is-black" }.each do |key, css| %>
      <%= layer.(:socks, key) do %>
        <path class="<%= css %>" d="<%= avatar_both(sock) %>" />
        <path d="<%= avatar_both("M66.8 290 L93.2 290 L93.1 295.4 L66.9 295.4 Z") %>" fill="url(#rib-<%= u %>)" />
        <% if key == "listrada" %>
          <path class="av-stripe-a" d="<%= avatar_both("M66.9 298 L93 298 L92.9 301.4 L67 301.4 Z") %>" />
          <path class="av-stripe-b" d="<%= avatar_both("M67 303.6 L92.9 303.6 L92.8 307 L67.1 307 Z") %>" />
        <% end %>
        <path d="<%= sock %>" fill="url(#cyl-<%= u %>)" /><path d="<%= avatar_mirror(sock) %>" fill="url(#cyl-<%= u %>)" />
      <% end %>
    <% end %>
    <%= layer.(:socks, "curta") do %>
      <path class="av-sock" d="<%= avatar_both("M68.2 321 L91.8 321 L91.6 331 L68.4 331 Z") %>" />
    <% end %>

    <%# Tênis de skate são largos: o desenho cresce a partir do chão %>
    <g transform="translate(100 348) scale(1.12 1.1) translate(-100 -348)">
    <% Avatar::OPTIONS[:shoes].each do |shoe| %>
      <% style = shoe_style.fetch(shoe.key) %>
      <%= layer.(:shoes, shoe.key) do %>
        <path d="<%= avatar_both(sole) %>" style="fill: <%= shoe.shade %>" />
        <path d="<%= avatar_both("M62.6 344.6 L95.4 344.6") %>" stroke="#000" stroke-opacity="0.22" stroke-width="1" />
        <path d="<%= avatar_both(upper) %>" style="fill: <%= shoe.color %>" />
        <path d="<%= avatar_both(toe) %>" style="fill: <%= style[:toe] %>" />
        <% if style[:ridges] %><path d="<%= avatar_both(ridges) %>" stroke="#9e9a90" stroke-width="0.9" fill="none" /><% end %>
        <% if style[:stitch] %><path d="<%= avatar_both("M67.6 338.4 C67.8 334.2 72.4 331.8 79 331.8 C85.6 331.8 90.2 334.2 90.4 338.4") %>" stroke="#ecebe6" stroke-opacity="0.6" stroke-width="0.7" stroke-dasharray="1.4 1.2" fill="none" /><% end %>
        <path d="<%= avatar_both(tongue) %>" style="fill: <%= shoe.color %>" />
        <path d="<%= avatar_both(tongue) %>" fill="#fff" opacity="0.1" />
        <path d="<%= avatar_both(laces) %>" style="stroke: <%= style[:laces] %>" stroke-width="1.3" stroke-linecap="round" fill="none" />
        <% if style[:stripe] %><path d="<%= avatar_both(stripe) %>" style="stroke: <%= style[:stripe] %>" stroke-width="2" stroke-linecap="round" fill="none" /><% end %>
        <% if style[:accent] %><circle cx="68.6" cy="333" r="1.3" style="fill: <%= style[:accent] %>" /><circle cx="131.4" cy="333" r="1.3" style="fill: <%= style[:accent] %>" /><% end %>
        <path d="<%= upper %>" fill="url(#cyl-<%= u %>)" /><path d="<%= avatar_mirror(upper) %>" fill="url(#cyl-<%= u %>)" />
        <path d="<%= avatar_both("M66 338.4 L92 338.4") %>" stroke="#fff" stroke-opacity="0.25" stroke-width="0.9" />
      <% end %>
    <% end %>
    </g>

    <% { "jeans-claro" => "av-jeans", "caqui" => "av-khaki", "cargo-preta" => "av-cargo" }.each do |key, css| %>
      <%= layer.(:bottom, key) do %>
        <path class="<%= css %>" d="<%= pants %>" />
        <% if key == "jeans-claro" %>
          <ellipse cx="82" cy="234" rx="7.5" ry="19" fill="#fff" opacity="0.22" /><ellipse cx="118" cy="234" rx="7.5" ry="19" fill="#fff" opacity="0.16" />
          <ellipse cx="79.6" cy="272" rx="6" ry="10" fill="#fff" opacity="0.12" /><ellipse cx="120.4" cy="272" rx="6" ry="10" fill="#fff" opacity="0.08" />
          <path d="<%= avatar_both("M88 200 C92 202 96 204 99 208 M86 206 C90 208 94 210 97 214") %>" stroke="#5d7286" stroke-opacity="0.4" stroke-width="0.9" fill="none" />
          <path d="<%= avatar_both("M66.6 193 C64 240 61 290 59.8 330") %>" stroke="#d39a52" stroke-opacity="0.5" stroke-width="0.8" stroke-dasharray="1.6 1" fill="none" />
        <% end %>
        <% if key == "cargo-preta" %>
          <path d="<%= avatar_both("M61.8 236 L74 236 L74.6 262 L61.2 262 Z") %>" fill="#35373c" stroke="#4d4f57" stroke-width="0.9" />
          <path d="<%= avatar_both("M61.6 236 L74.2 236 L74.3 242.6 L61.5 242.6 Z") %>" fill="#3d3f45" stroke="#4d4f57" stroke-width="0.9" />
        <% end %>
        <% if key == "caqui" %>
          <path d="<%= avatar_both("M82 196 C81 240 79 290 77.6 330") %>" stroke="#7d5a33" stroke-opacity="0.35" stroke-width="1" fill="none" />
        <% end %>
      <% end %>
    <% end %>
    <%= layer.(:bottom, "camuflada") do %>
      <path d="<%= pants %>" fill="url(#camo-<%= u %>)" />
    <% end %>
    <%= layer.(:bottom, "bermuda-preta") do %>
      <path class="av-jorts" d="<%= shorts %>" />
      <path d="<%= avatar_both("M59.2 261.6 L96.3 262.6") %>" stroke="#5a5c63" stroke-width="1" stroke-dasharray="1.6 1" fill="none" />
      <path d="<%= avatar_both("M66.6 193 C64.6 216 62 242 59.6 266") %>" stroke="#5a5c63" stroke-width="0.8" stroke-dasharray="1.6 1" fill="none" />
      <path d="<%= avatar_both("M66 240 C74 244 84 244 94 240") %>" stroke="#000" stroke-opacity="0.3" stroke-width="1.2" fill="none" />
      <ellipse cx="82" cy="230" rx="7" ry="14" fill="#fff" opacity="0.07" />
    <% end %>

    <%# Volume, cintura, bolsos e dobras (valem para todas as calças) %>
    <% Avatar::OPTIONS[:bottom].each do |bottom| %>
      <% long = bottom.key != "bermuda-preta" %>
      <%= layer.(:bottom, bottom.key) do %>
        <path d="<%= long ? leg : short_leg %>" fill="url(#cyl-<%= u %>)" />
        <path d="<%= avatar_mirror(long ? leg : short_leg) %>" fill="url(#cyl-<%= u %>)" />
        <path d="<%= long ? pants : shorts %>" fill="url(#fall-<%= u %>)" />
        <path d="<%= avatar_both("M100 218 C99 236 98.4 250 98 262") %>" stroke="#000" stroke-opacity="0.3" stroke-width="2.4" fill="none" />
        <% if long %><path d="<%= avatar_both(pant_folds) %>" stroke="#000" stroke-opacity="0.24" stroke-width="1.3" stroke-linecap="round" fill="none" /><% end %>
        <% if long %><path d="<%= avatar_both("M61 304 C72 308.4 84 308.4 96 304.4 M60.8 312.4 C72 316.6 84 316.6 96 312.8") %>" stroke="#fff" stroke-opacity="0.12" stroke-width="1" fill="none" /><% end %>
        <path d="<%= waistband %>" fill="#000" opacity="0.14" />
        <path d="<%= loops %>" fill="#000" opacity="0.2" />
        <path d="<%= fly %>" stroke="#000" stroke-opacity="0.35" stroke-width="0.9" fill="none" />
        <path d="<%= pockets %>" stroke="#000" stroke-opacity="0.35" stroke-width="1" fill="none" />
        <circle cx="100" cy="189.6" r="1.3" fill="#c9b27a" />
      <% end %>
    <% end %>
    <%# A blusa faz sombra na calça %>
    <path d="M63.6 186 L136.4 186 L136.8 208 L63.2 208 Z" fill="url(#ao-<%= u %>)" />
  </g>

