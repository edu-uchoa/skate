<% content_for :section, "Cadastro" %>

<section class="auth-screen">
  <header class="auth-head">
    <span class="material-symbols-outlined auth-icon">person_add</span>
    <h2 class="screen-title">Crie sua conta</h2>
    <p class="screen-desc">
      Entre com a sua conta Google: a trilha, os vídeos, o XP e as devolutivas ficam guardados nela.
      Depois você escolhe o nickname com que aparece no app.
    </p>
  </header>

  <%= render "shared/google_button" %>

  <div class="auth-links">
    <%= link_to "Já tenho conta — entrar", new_session_path, class: "auth-link" %>
  </div>

  <p class="auth-note">
    <span class="material-symbols-outlined" style="font-size: 15px;">lock</span>
    O FlipaAi não vê sua senha do Google. Ele usa só o seu e-mail, que ninguém no app vê.
  </p>
</section>
