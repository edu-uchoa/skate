<% content_for :section, "Perfil" %>
<% level = @stats.level %>
<% progress = level.progress(@stats.xp) %>

<section class="profile-screen">
  <header class="profile-hero">
    <div class="profile-hero-avatar"><%= render "avatars/avatar", look: @look, deck: @deck, uid: "hero", crop: true %></div>
    <div class="profile-hero-info">
      <span class="step-indicator">Seu perfil</span>
      <h2 class="screen-title">Nível <%= level.number %></h2>
      <span class="auth-hint profile-handle"><%= current_user.handle || masked_contact(current_user) %></span>
      <div class="profile-xp" role="progressbar" aria-label="XP até o próximo nível"
           aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= progress %>">
        <span style="width: <%= progress %>%;"></span>
      </div>
      <span class="profile-xp-label">
        <strong><%= @stats.xp %> XP</strong> · faltam <%= level.ceiling - @stats.xp %> para o nível <%= level.number + 1 %>
      </span>
    </div>
  </header>

  <%# Conta de mentor: como os aprendizes o veem na hora de escolher quem avalia o vídeo. %>
  <% if current_user.mentor_account? %>
    <section class="auth-card mentor-profile" id="mentor">
      <span class="auth-card-label">Seu perfil de mentor</span>
      <% if current_user.nickname.blank? %>
        <%# Sem nickname o mentor não entra na lista de escolha dos aprendizes (User.available_mentors). %>
        <p class="zine-status warn">
          <span class="material-symbols-outlined" aria-hidden="true">badge</span>
          <span>Escolha um nickname: sem ele, os aprendizes não conseguem escolher você para avaliar os vídeos.</span>
        </p>
        <%= link_to "Escolher o nickname", edit_nickname_path, class: "auth-link" %>
      <% end %>
      <strong class="mentor-name"><%= mentor_name(current_user) %></strong>
      <%= mentor_score(@mentor_score) %>
      <span class="auth-hint">
        Os aprendizes escolhem quem avalia cada vídeo vendo o seu nome, o resumo e a média de
        rolamentos (de 1 a 10) que eles dão nas suas devolutivas.
      </span>

      <%= form_with url: mentor_profile_path, method: :patch, scope: :mentor_profile, class: "auth-form" do |f| %>
        <%= f.label :bio, "Resumo profissional", class: "auth-label" %>
        <%= f.text_area :bio, value: flash[:mentor_bio] || current_user.mentor_bio, rows: 4,
              maxlength: User::MENTOR_BIO_LENGTH, class: "auth-input",
              placeholder: "Ex.: Ando há 12 anos e dou aula de street para quem está começando." %>
        <span class="auth-hint">
          Até <%= User::MENTOR_BIO_LENGTH %> caracteres. Sem telefone, e-mail, links ou @: o contato com os aprendizes é só pelo app.
        </span>
        <%= f.button "Salvar resumo", type: :submit, class: "auth-secondary-btn" %>
      <% end %>

      <% if @recent_ratings.any? %>
        <span class="auth-card-label">O que os alunos disseram</span>
        <ul class="mentor-feedback">
          <% @recent_ratings.each do |review| %>
            <li>
              <span class="mentor-score"><%= rolamento_icon %> <strong><%= review.rating %></strong></span>
              <span><%= review.rating_comment || "Sem mensagem." %></span>
              <small><%= review.rated_at.in_time_zone(current_user.time_zone).strftime("%d/%m") %></small>
            </li>
          <% end %>
        </ul>
        <span class="auth-hint">Sem o nome do aluno, para todo mundo avaliar à vontade.</span>
      <% end %>
    </section>
  <% end %>

  <div class="profile-stats">
    <%# Botão: abre a página da ofensiva (como funciona e justificativa de parada). %>
    <%= link_to streak_path, class: "profile-stat is-streak is-button", aria: { label: "Ofensiva: #{streak_sessions_label(@streak.count)}. Ver como funciona" } do %>
      <span class="material-symbols-outlined">local_fire_department</span>
      <span class="material-symbols-outlined profile-stat-go">chevron_right</span>
      <strong><%= streak_sessions_label(@streak.count) %></strong>
      <span>Ofensiva · <%= streak_state_label(@streak) %></span>
    <% end %>
    <div class="profile-stat">
      <span class="material-symbols-outlined">skateboarding</span>
      <strong><%= SkateStyle.name(@stats.favorite_style) || "Descobrindo" %></strong>
      <span>Estilo favorito</span>
    </div>
    <%# Botão: abre a lista de tarefas (concluídas e as que faltam). %>
    <%= link_to tasks_path, class: "profile-stat is-tasks is-button",
          aria: { label: "Tarefas concluídas: #{@stats.completed_count} de #{@stats.total_count}. Ver todas" } do %>
      <span class="material-symbols-outlined">task_alt</span>
      <span class="material-symbols-outlined profile-stat-go">chevron_right</span>
      <strong><%= @stats.completed_count %> de <%= @stats.total_count %></strong>
      <span>Tarefas concluídas</span>
    <% end %>
    <div class="profile-stat is-soon">
      <span class="material-symbols-outlined">military_tech</span>
      <strong>Em breve</strong>
      <span>Rank</span>
    </div>
  </div>
  <p class="auth-hint">
    A ofensiva soma uma sessão a cada rolê comprovado com vídeo e só zera depois de 7 dias sem andar.
    O XP vem de cada tarefa que o mentor conclui, e o estilo favorito, das tarefas que você mais treina.
  </p>

  <div class="profile-tabs" id="personalizar">
    <input type="radio" name="profile-tab" id="profile-tab-avatar" value="avatar" <%= "checked" if @tab == "avatar" %>>
    <label for="profile-tab-avatar"><span class="material-symbols-outlined">face</span> Avatar</label>
    <input type="radio" name="profile-tab" id="profile-tab-skate" value="skate" <%= "checked" if @tab == "skate" %>>
    <label for="profile-tab-skate"><span class="material-symbols-outlined">skateboarding</span> Skate</label>
  </div>
  <div class="profile-panel is-avatar"><%= render "avatars/editor", look: @look, deck: @deck %></div>
  <div class="profile-panel is-skate"><%= render "decks/editor", deck: @deck %></div>

  <section class="profile-account">
    <h3 class="auth-card-label">Conta</h3>
    <div class="auth-card">
      <span class="auth-card-label">Nickname</span>
      <span class="auth-card-value"><%= current_user.handle || "Ainda não escolhido" %></span>
      <span class="auth-hint">É assim que outros skatistas e os mentores te veem.</span>
      <%= link_to (current_user.handle ? "Trocar o nickname" : "Escolher o nickname"), edit_nickname_path, class: "auth-link" %>
    </div>

    <div class="auth-card">
      <span class="auth-card-label"><%= current_user.google? ? "Conta Google" : (current_user.email ? "E-mail" : "Telefone (WhatsApp)") %></span>
      <span class="auth-card-value"><%= current_user.contact %></span>
      <% if current_user.google? %>
        <span class="auth-hint">Conta criada em <%= current_user.registered_at.strftime("%d/%m/%Y") %>. Entre com esta conta Google em qualquer aparelho.</span>
      <% else %>
        <span class="auth-hint">Conta antiga, com senha. Ligue ao Google para entrar só com ele: a trilha, os vídeos e o XP continuam.</span>
        <%= render "shared/google_button" %>
      <% end %>
    </div>

    <%= link_to install_path, class: "auth-link install-link" do %>
      <span class="material-symbols-outlined">install_mobile</span> Instalar o FlipaAi no celular
    <% end %>

    <% if current_user.mentor_access? %>
      <%= link_to "Abrir a Zine do mentor", mentor_zine_path, class: "auth-link" %>
    <% elsif current_user.mentor_requested? %>
      <%= link_to "Pedido de mentor em análise", new_mentor_application_path, class: "auth-muted-link" %>
    <% else %>
      <%= link_to "Quero ser mentor", new_mentor_application_path, class: "auth-link" %>
    <% end %>

    <%# LGPD: ver, levar e apagar os próprios dados, sem precisar pedir para ninguém. %>
    <div class="auth-card profile-privacy">
      <span class="auth-card-label">Seus dados</span>
      <span class="auth-hint">Veja o que o FlipaAi guarda, baixe uma cópia ou apague tudo quando quiser.</span>
      <%= link_to my_data_path(format: :json), class: "auth-link", data: { turbo: false } do %>
        <span class="material-symbols-outlined" aria-hidden="true">download</span> <span class="link-text">Baixar meus dados</span>
      <% end %>
      <%= link_to privacy_path, class: "auth-link" do %>
        <span class="material-symbols-outlined" aria-hidden="true">shield_lock</span> <span class="link-text">Política de Privacidade</span>
      <% end %>
      <%= link_to terms_path, class: "auth-link" do %>
        <span class="material-symbols-outlined" aria-hidden="true">gavel</span> <span class="link-text">Termos de Uso</span>
      <% end %>
      <%= link_to account_deletion_path, class: "auth-link danger-link" do %>
        <span class="material-symbols-outlined" aria-hidden="true">delete_forever</span> <span class="link-text">Apagar minha conta</span>
      <% end %>
    </div>

    <div class="auth-actions">
      <%= button_to "Sair deste aparelho", sign_out_path, method: :delete, class: "auth-secondary-btn" %>
      <%= button_to "Sair de todos os aparelhos", sign_out_everywhere_path, method: :delete,
            class: "auth-secondary-btn danger" %>
    </div>
  </section>
</section>
