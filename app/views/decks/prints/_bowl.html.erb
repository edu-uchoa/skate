<%# Estampa "Monstro verde" (bowl): uma cara de monstro bem grande, de boca aberta,
    no verde neon. Desenhada no shape de 140 x 380 (centro x = 70). %>
<% line = "#0c3b16" %>
<rect width="140" height="380" fill="#2fd04e" />
<radialGradient id="shade-<%= uid %>" cx="0.5" cy="0.45" r="0.6">
  <stop offset="0.55" stop-color="#000" stop-opacity="0" />
  <stop offset="1" stop-color="#000" stop-opacity="0.35" />
</radialGradient>
<rect width="140" height="380" fill="url(#shade-<%= uid %>)" />
<g fill="#24b13f">
  <circle cx="34" cy="40" r="4" /><circle cx="104" cy="52" r="3" /><circle cx="30" cy="330" r="3.5" /><circle cx="108" cy="320" r="4.5" />
</g>

<%# Cabeça %>
<path d="M30 122 C28 82 46 58 70 58 C94 58 112 82 110 122 C112 170 108 220 100 262 C94 294 82 310 70 310 C58 310 46 294 40 262 C32 220 28 170 30 122 Z"
      fill="#57e06f" stroke="<%= line %>" stroke-width="2.6" />
<path d="M40 96 C52 90 62 92 70 96 C78 92 88 90 100 96 M44 108 C54 103 62 104 70 108 C78 104 86 103 96 108"
      fill="none" stroke="<%= line %>" stroke-width="2" stroke-linecap="round" />
<%# Cicatriz com pontos %>
<path d="M56 66 L66 90" stroke="<%= line %>" stroke-width="2" stroke-linecap="round" />
<path d="M55 74 L62 71 M57 80 L64 77 M59 86 L66 83" stroke="<%= line %>" stroke-width="1.4" stroke-linecap="round" />

<%# Sobrancelhas bravas e olhos esbugalhados %>
<% [ nil, "translate(140 0) scale(-1 1)" ].each do |mirror| %>
  <g transform="<%= mirror %>">
    <path d="M30 132 C42 118 56 120 67 134 L62 141 C54 133 42 131 32 141 Z" fill="#1f9a37" stroke="<%= line %>" stroke-width="2" stroke-linejoin="round" />
    <ellipse cx="50" cy="152" rx="13.5" ry="14.5" fill="#f7f5ee" stroke="<%= line %>" stroke-width="2.2" />
    <path d="M38 148 L43 150 M39 159 L44 157 M60 162 L56 159" stroke="#d64545" stroke-width="0.9" stroke-linecap="round" />
    <path d="M38 166 C44 172 56 172 62 166" fill="none" stroke="<%= line %>" stroke-width="1.6" stroke-linecap="round" />
  </g>
<% end %>
<circle cx="53" cy="154" r="7.2" fill="#3b8cff" stroke="<%= line %>" stroke-width="1" /><circle cx="87" cy="154" r="7.2" fill="#3b8cff" stroke="<%= line %>" stroke-width="1" />
<circle cx="53" cy="154" r="3.4" fill="#111" /><circle cx="87" cy="154" r="3.4" fill="#111" />
<circle cx="55.2" cy="151.4" r="1.7" fill="#fff" /><circle cx="89.2" cy="151.4" r="1.7" fill="#fff" />

<%# Nariz %>
<path d="M61 182 C59 191 63 198 70 198 C77 198 81 191 79 182" fill="#46cf60" stroke="<%= line %>" stroke-width="2" stroke-linecap="round" />
<ellipse cx="64.4" cy="193" rx="2.6" ry="2" fill="<%= line %>" /><ellipse cx="75.6" cy="193" rx="2.6" ry="2" fill="<%= line %>" />

<%# Boca aberta, com dentes tortos %>
<path d="M35 214 C44 204 58 206 70 210 C82 206 96 204 105 214 C109 238 101 264 87 274 C78 280 62 280 53 274 C39 264 31 238 35 214 Z"
      fill="#b3127e" stroke="<%= line %>" stroke-width="2.6" />
<ellipse cx="70" cy="248" rx="17" ry="13" fill="#5e0742" />
<path d="M51 264 C58 250 82 250 89 264 C80 274 60 274 51 264 Z" fill="#ff5fa2" stroke="#8a0d5f" stroke-width="1.2" />
<path d="M70 256 L70 268" stroke="#c43a7c" stroke-width="1.2" />
<path d="M38 214 L44 233 L50 211 L56 229 L62 209 L67 226 L72 210 L78 229 L84 209 L90 232 L96 210 L101 228 L104 214 C92 207 82 207 70 211 C58 207 48 207 38 214 Z"
      fill="#f4f1e6" stroke="<%= line %>" stroke-width="1.3" stroke-linejoin="round" />
<path d="M45 268 L50 256 L55 270 L62 258 L66 273 L74 273 L78 258 L85 270 L90 256 L95 268 C88 276 78 279 70 279 C62 279 52 276 45 268 Z"
      fill="#f4f1e6" stroke="<%= line %>" stroke-width="1.3" stroke-linejoin="round" />
<%# Baba %>
<path d="M60 278 C60 288 58 296 60 300" stroke="#b8f5c5" stroke-width="3" fill="none" stroke-linecap="round" />
<circle cx="60" cy="302" r="2.6" fill="#b8f5c5" />
