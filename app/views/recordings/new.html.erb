<% content_for :section, "Gravar" %>
<% max_seconds = TrainingSession.max_clip_seconds %>
<% cut_seconds = TrainingSession::CLIP_CUT_SECONDS %>

<section class="rec-screen"
         data-controller="recorder"
         data-recorder-max-seconds-value="<%= max_seconds %>"
         data-recorder-max-bytes-value="<%= TrainingSession.max_clip_bytes %>"
         data-recorder-types-value="<%= TrainingSession::CLIP_CONTENT_TYPES.to_json %>"
         data-recorder-owner-value="<%= upload_owner_key %>"
         data-recorder-clip-trim-outlet="#rec-preview">

  <header class="auth-head">
    <span class="step-indicator">Devolutiva do mentor em até 48h</span>
    <h2 class="screen-title">Grave sua manobra</h2>
    <p class="screen-desc">
      Posicione o celular de lado, pegando o corpo inteiro e o skate. Depois você corta só o trecho da tentativa, com até <%= cut_seconds %> segundos.
    </p>
    <p class="zine-expiry">
      <span class="material-symbols-outlined" aria-hidden="true">auto_delete</span>
      O vídeo fica guardado por 1 mês a partir do envio e depois é apagado sozinho.
    </p>
  </header>

  <% if @meetup_now %>
    <p class="auth-card rec-meetup">
      <span class="material-symbols-outlined">local_fire_department</span>
      <span>Você está no rolê em <strong><%= @meetup_now.place_name %></strong>: este vídeo vale para a sua ofensiva.</span>
    </p>
  <% end %>

  <ul class="auth-errors" role="alert" data-recorder-target="errors" <%= "hidden" unless @training_session&.errors&.any? %>>
    <% @training_session&.errors&.full_messages&.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>

  <%= form_with url: recording_path, scope: :recording, multipart: true, class: "rec-form",
        data: { recorder_target: "form", action: "submit->recorder#upload" } do |f| %>

    <div class="auth-field">
      <%= f.label :maneuver_slug, "Manobra", class: "auth-label" %>
      <%= f.select :maneuver_slug, @maneuvers.map { |m| [ "#{m.code} · #{m.name}", m.slug ] },
            { selected: @maneuver&.slug }, class: "auth-input" %>
    </div>

    <%# 1. Escolha: câmera ou upload %>
    <div class="rec-options" data-recorder-target="chooser">
      <button type="button" class="option-card rec-option" data-action="recorder#openCamera">
        <span class="material-symbols-outlined rec-option-icon">videocam</span>
        <span class="rec-option-text">
          <strong>Gravar com a câmera</strong>
          <small>Para sozinho em <%= max_seconds %>s</small>
        </span>
      </button>

      <button type="button" class="option-card rec-option" data-action="recorder#pickFile">
        <span class="material-symbols-outlined rec-option-icon">upload</span>
        <span class="rec-option-text">
          <strong>Fazer upload de vídeo</strong>
          <small>MP4, MOV ou WebM · depois você corta até <%= cut_seconds %>s</small>
        </span>
      </button>

      <%= f.file_field :clip, accept: "video/mp4,video/quicktime,video/webm,.mp4,.mov,.m4v,.webm",
            class: "rec-hidden-input", data: { recorder_target: "fileInput", action: "change->recorder#fileChosen" } %>
      <%# Sem MediaRecorder (ex.: http fora de localhost), abre a câmera nativa do celular. %>
      <input type="file" accept="video/*" capture="environment" class="rec-hidden-input"
             data-recorder-target="captureInput" data-action="change->recorder#fileChosen">
    </div>

    <%# 2. Câmera ao vivo %>
    <div class="rec-stage" data-recorder-target="camera" hidden>
      <div class="rec-video-frame">
        <video data-recorder-target="live" autoplay muted playsinline></video>
        <span class="rec-timer" data-recorder-target="timer">00:00 / 00:<%= format("%02d", max_seconds) %></span>
        <%# Trocar entre a câmera traseira e a frontal (só aparece com mais de uma câmera). %>
        <button type="button" class="rec-switch-btn" data-recorder-target="switchButton"
                data-action="recorder#switchCamera" aria-label="Trocar de câmera" title="Trocar de câmera" hidden>
          <span class="material-symbols-outlined" aria-hidden="true">cameraswitch</span>
        </button>
      </div>
      <p class="zine-status info" data-recorder-target="notice" hidden></p>
      <div class="rec-controls">
        <button type="button" class="auth-secondary-btn" data-action="recorder#closeCamera">Cancelar</button>
        <button type="button" class="rec-record-btn" data-recorder-target="recordButton" data-action="recorder#toggleRecording">
          <span class="rec-record-dot"></span>
          <span data-recorder-target="recordLabel">Gravar</span>
        </button>
      </div>
    </div>

    <%# 3. Pré-visualização e barra de corte (clip_trim_controller) antes do envio %>
    <div class="rec-stage" id="rec-preview" data-recorder-target="preview" hidden
         data-controller="clip-trim" data-clip-trim-max-seconds-value="<%= cut_seconds %>">
      <div class="rec-video-frame">
        <%# Os controles normais somem quando a barra de corte aparece (ela tem o play). %>
        <video data-recorder-target="previewVideo" data-clip-trim-target="video" controls playsinline preload="auto"
               data-action="click->clip-trim#togglePlay play->clip-trim#played pause->clip-trim#paused timeupdate->clip-trim#renderPlayhead"></video>
      </div>
      <p class="auth-hint" data-recorder-target="meta"></p>

      <%# Só o trecho escolhido vai para o mentor (quem corta é o servidor: ClipSanitizer). %>
      <div class="rec-trim" data-clip-trim-target="editor" role="group" aria-labelledby="rec-trim-title" hidden>
        <div class="rec-trim-head">
          <span class="auth-label" id="rec-trim-title">Corte o vídeo</span>
          <span class="rec-trim-length">
            <strong data-clip-trim-target="length"></strong> · máx. <%= cut_seconds %>s
          </span>
        </div>
        <div class="rec-trim-bar">
          <button type="button" class="rec-trim-play" data-clip-trim-target="playButton"
                  data-action="clip-trim#togglePlay" aria-label="Tocar o trecho">
            <span class="material-symbols-outlined" aria-hidden="true" data-clip-trim-target="playIcon">play_arrow</span>
          </button>
          <div class="rec-trim-track" data-clip-trim-target="track"
               data-action="pointerdown->clip-trim#grab pointermove->clip-trim#drag pointerup->clip-trim#drop pointercancel->clip-trim#drop">
            <div class="rec-trim-range" data-clip-trim-target="range">
              <span class="rec-trim-handle is-start" role="slider" tabindex="0" aria-label="Começo do trecho"
                    data-edge="start" data-clip-trim-target="startHandle" data-action="keydown->clip-trim#nudge"></span>
              <span class="rec-trim-handle is-end" role="slider" tabindex="0" aria-label="Fim do trecho"
                    data-edge="end" data-clip-trim-target="endHandle" data-action="keydown->clip-trim#nudge"></span>
            </div>
            <span class="rec-trim-playhead" data-clip-trim-target="playhead"></span>
          </div>
          <div class="rec-trim-times">
            <span>Começa <strong data-clip-trim-target="from"></strong></span>
            <span>Termina <strong data-clip-trim-target="to"></strong></span>
          </div>
        </div>
        <ol class="rec-trim-tips">
          <li>Arraste as bordas amarelas até o começo e o fim da sua tentativa.</li>
          <li>Arraste o meio da barra para mover o trecho inteiro.</li>
          <li>Dê o play para conferir: só esse trecho vai para o mentor.</li>
        </ol>
      </div>
      <p class="zine-status warn" data-clip-trim-target="fallback" hidden>
        <span class="material-symbols-outlined" aria-hidden="true">content_cut</span>
        Não deu para ler o tamanho deste vídeo aqui, então vão os primeiros <%= cut_seconds %> segundos.
      </p>

      <%= f.hidden_field :duration_seconds, data: { recorder_target: "duration", clip_trim_target: "duration" } %>
      <%= f.hidden_field :cut_from, data: { clip_trim_target: "cutFrom" } %>
      <%= f.hidden_field :cut_to, data: { clip_trim_target: "cutTo" } %>

      <button type="button" class="auth-secondary-btn" data-action="recorder#discard">
        Descartar e escolher outro
      </button>
    </div>

    <fieldset class="rec-checklist">
      <legend class="auth-label">Checklist de segurança</legend>
      <% { gear_checked: "Capacete e joelheiras bem firmes",
           ground_clear: "Chão plano e sem pedrinhas",
           space_safe:   "Ambiente seguro e livre de perigos" }.each do |attribute, label| %>
        <label class="rec-check">
          <%# Vindo do checklist pré-sessão, os itens já chegam marcados (?checklist=ok). %>
          <%= f.check_box attribute, checked: params[:checklist] == "ok", data: { recorder_target: "check", action: "recorder#refresh" } %>
          <span><%= label %></span>
        </label>
      <% end %>
    </fieldset>

    <%= render "shared/mentor_picker", f: f, recorder: true %>

    <%= f.hidden_field :source, data: { recorder_target: "source" } %>

    <%# Enquanto o vídeo é guardado para enviar (o anel de envio vem na tela seguinte). %>
    <div class="rec-progress" data-recorder-target="progress" hidden>
      <p class="auth-hint" data-recorder-target="progressLabel">Guardando o vídeo para enviar…</p>
    </div>

    <%= f.button type: :submit, class: "tactile-btn-primary", data: { recorder_target: "submit" } do %>
      <span>Enviar vídeo</span>
      <span class="material-symbols-outlined btn-arrow">cloud_upload</span>
    <% end %>
  <% end %>

  <%= render "recordings/sending", autostart: false %>
</section>
