<% flash.each do |type, message| %>
  <div class="card mb-md flex items-start gap-xs <%= type.to_s == 'alert' ? 'border-error/40' : 'border-primary/40' %>">
    <span class="material-symbols-outlined <%= type.to_s == 'alert' ? 'text-error' : 'text-primary' %>">
      <%= type.to_s == "alert" ? "error" : "check_circle" %>
    </span>
    <p class="text-body-md text-on-surface"><%= message %></p>
  </div>
<% end %>
