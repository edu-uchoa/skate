<% flash.each do |type, message| %>
  <div class="flash-message <%= 'alert' if type.to_s == 'alert' %>" role="<%= type.to_s == 'alert' ? 'alert' : 'status' %>">
    <span class="material-symbols-outlined"><%= type.to_s == "alert" ? "error" : "check_circle" %></span>
    <p><%= message %></p>
  </div>
<% end %>
