<!DOCTYPE html>
<html class="dark" lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "FlipaAi · Bora andar de skate!" %></title>
    <meta charset="utf-8">
    <%# Sem bloquear o zoom (acessibilidade). No celular os campos têm letra de 16px
        (custom_styles.css): abaixo disso o iPhone dá zoom sozinho ao tocar num campo. %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <%# App instalado na tela do celular (PWA, página /instalar): abre em tela cheia.
        No iPhone, a barra de status fica por cima do app; o cabeçalho e o menu de
        baixo já descontam o entalhe e a barrinha (env(safe-area-inset-*)). %>
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="FlipaAi">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <meta name="theme-color" content="#121317">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="manifest" href="<%= pwa_manifest_path %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@800;900&family=Inter:wght@500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

    <%# Cada estilo uma vez só, nesta ordem: os do app (custom_styles) por último, vencendo
        o Tailwind. Antes, o :app trazia o custom_styles e ele vinha de novo aqui. %>
    <%= stylesheet_link_tag "application", "tailwind", "custom_styles", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# data-signed-in: sem conta (ou logo depois de sair), o application.js apaga as telas guardadas para o "voltar". %>
  <body class="bg-[#121316] text-[#e3e2e6]" style="font-family: 'Inter', sans-serif; background: #121316; color: #e3e2e6; margin: 0; overflow: hidden;"
        data-signed-in="<%= signed_in? %>">
    <div class="grain"></div>

    <!-- App em tela cheia; em tablet e computador o conteúdo fica numa coluna central (--app-column) -->
    <div class="phone-container<%= " no-app-menus" unless show_app_menus? %>" data-controller="app-menu">

      <!-- Menu de cima: some junto com o de baixo antes da trilha (show_app_menus?) -->
      <% if show_app_menus? %>
      <header class="phone-header-bar">
        <div class="header-left">
          <%# ☰: abre o painel de atalhos (shared/_app_menu). %>
          <button type="button" class="icon-btn" data-app-menu-target="button" data-action="app-menu#toggle"
                  aria-expanded="false" aria-controls="app-menu-panel" aria-label="Abrir o menu" title="Menu">
            <span class="material-symbols-outlined" style="font-size: 24px;">menu</span>
          </button>
        </div>
        <div class="header-right" style="display: flex; align-items: center;">
          <% if signed_in? && current_user.super_admin? %>
            <%= link_to admin_root_path, class: "icon-btn", title: "Painel do super administrador", aria: { label: "Painel do super administrador" } do %>
              <span class="material-symbols-outlined" style="font-size: 22px;">shield_person</span>
            <% end %>
          <% end %>
          <%# Administrador (conta de mentor): os pedidos de mentor. O mentor navega pelo menu de baixo. %>
          <% if signed_in? && current_user.role_admin? %>
            <%= link_to mentor_requests_path, class: "icon-btn nav-icon-wrap", title: "Mentores", aria: { label: "Mentores" } do %>
              <span class="material-symbols-outlined" style="font-size: 22px;">admin_panel_settings</span>
              <%= nav_badge(mentor_nav_counts[:requests], "pedidos de mentor") %>
            <% end %>
          <% end %>
          <%# Super admin (que também é aprendiz): atalho para a área do mentor. %>
          <% if signed_in? && current_user.mentor_access? && !current_user.mentor_account? %>
            <%= link_to mentor_zine_path, class: "icon-btn", title: "Zine do mentor", aria: { label: "Zine do mentor" } do %>
              <span class="material-symbols-outlined" style="font-size: 22px;">school</span>
            <% end %>
          <% end %>
          <% if signed_in? %>
            <%= link_to my_account_path, class: "icon-btn", title: "Minha conta", aria: { label: "Minha conta" } do %>
              <span class="material-symbols-outlined" style="font-size: 22px;">account_circle</span>
            <% end %>
          <% else %>
            <%= link_to root_path, class: "icon-btn", title: "Entrar", aria: { label: "Entrar" } do %>
              <span class="material-symbols-outlined" style="font-size: 22px;">login</span>
            <% end %>
          <% end %>
          <%= link_to new_support_request_path, class: "icon-btn help-btn", title: "Dúvidas e suporte", aria: { label: "Ajuda" } do %>
            <span class="material-symbols-outlined" style="font-size: 22px;">help</span>
          <% end %>
        </div>
      </header>
      <%= render "shared/app_menu" %>
      <% end %>

      <!-- Main Screens Content Viewport -->
      <div class="phone-content" style="overflow-y: auto;">
        <%= render "shared/flash" %>
        <%# Sobrou vídeo guardado neste aparelho esperando internet: leva à tela de envio. %>
        <% if signed_in? && !current_user.mentor_account? %>
          <%= link_to sending_recording_path, class: "pending-upload", hidden: true,
                data: { controller: "pending-upload", pending_upload_owner_value: upload_owner_key } do %>
            <span class="material-symbols-outlined" aria-hidden="true">cloud_upload</span>
            <span data-pending-upload-target="label"></span>
            <strong>Enviar agora</strong>
          <% end %>
        <% end %>

        <div class="screen active app-column" style="position: relative; display: flex; flex-direction: column;">
          <%= yield %>
        </div>
      </div>

      <!-- Bottom Navigation: a de mentor (Todos, Na fila, Ofensivas, Chat) ou a de aprendiz -->
      <% if show_app_menus? && mentor_nav? %>
        <%= render "shared/mentor_nav" %>
      <% elsif show_app_menus? %>
      <nav class="phone-bottom-nav">
        <a href="<%= my_account_path %>" class="nav-btn <%= 'active' if controller_name == "accounts" && action_name == "show" %>">
          <span class="material-symbols-outlined" style="font-size: 22px;">person</span>
          <span class="nav-label">Perfil</span>
        </a>
        <a href="<%= track_path %>" class="nav-btn <%= 'active' if controller_name == "tracks" %>">
          <span class="material-symbols-outlined" style="font-size: 22px;">route</span>
          <span class="nav-label">Trilha</span>
        </a>
        <div class="nav-fab-container">
          <%= link_to new_recording_path, class: "nav-fab-btn", title: "Gravar manobra", aria: { label: "Gravar" } do %>
            <span class="material-symbols-outlined" style="font-size: 26px; font-weight: 900;">videocam</span>
          <% end %>
          <span class="nav-fab-label">Gravar</span>
        </div>
        <a href="<%= spots_path %>" class="nav-btn <%= 'active' if current_page?(spots_path) %>">
          <span class="material-symbols-outlined" style="font-size: 22px;">map</span>
          <span class="nav-label">Picos</span>
        </a>
        <%# Mentor e administrador: a aba Zine leva à Zine do mentor (vídeos dos aprendizes). %>
        <% if signed_in? && current_user.mentor_access? %>
          <a href="<%= mentor_zine_path %>" class="nav-btn <%= 'active' if controller_path.start_with?("mentor/") %>">
            <span class="material-symbols-outlined" style="font-size: 22px;">auto_stories</span>
            <span class="nav-label">Zine</span>
          </a>
        <% else %>
          <%# O número aparece quando chega uma devolutiva que o aprendiz ainda não abriu. %>
          <a href="<%= zine_path %>" class="nav-btn <%= 'active' if current_page?(zine_path) %>">
            <span class="nav-icon-wrap">
              <span class="material-symbols-outlined" style="font-size: 22px;">auto_stories</span>
              <%= nav_badge(new_reviews_count, new_reviews_count == 1 ? "devolutiva nova" : "devolutivas novas") %>
            </span>
            <span class="nav-label">Zine</span>
          </a>
        <% end %>
      </nav>
      <% end %>

    </div>
  </body>
</html>
