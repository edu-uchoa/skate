<!DOCTYPE html>
<html class="dark" lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Skate" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#121317">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="manifest" href="<%= pwa_manifest_path %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@700;800&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh bg-surface font-body text-body-md text-on-surface antialiased">
    <%= render "shared/header" %>

    <main class="mx-auto w-full max-w-[980px] pb-xl pt-20">
      <%= render "shared/flash" %>
      <%= render "shared/anonymous_banner" if anonymous_profile? && current_user.onboarded? %>
      <%= yield %>
    </main>
  </body>
</html>
