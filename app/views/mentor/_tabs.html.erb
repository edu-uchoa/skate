<%# Abas da área do mentor. current: "fila", "todos" ou "pedidos" (este só para administrador). %>
<% tabs = [
     [ "fila",  "schedule",      "Na fila (#{@queue_count})", mentor_zine_path(aba: "fila") ],
     [ "todos", "video_library", "Todos (#{@video_count})",   mentor_zine_path(aba: "todos") ]
   ] %>
<% tabs << [ "pedidos", "admin_panel_settings", "Mentores (#{@request_count})", mentor_requests_path ] if current_user.role_admin? %>
<nav class="guide-tabs mentor-tabs" style="grid-template-columns: repeat(<%= tabs.size %>, 1fr);" aria-label="Abas da área do mentor">
  <% tabs.each do |key, icon, label, path| %>
    <%= link_to path, class: [ "guide-tab", ("is-active" if current == key) ],
                aria: { current: (current == key ? "page" : nil) } do %>
      <span class="material-symbols-outlined"><%= icon %></span> <%= label %>
    <% end %>
  <% end %>
</nav>
