<% content_for :section, "Mentor" %>
<%# Sem cópia guardada pelo Turbo: a fila muda (ex.: depois de enviar uma devolutiva, o voltar mostrava a fila antiga, com o formulário). %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>

<section class="zine-screen">
  <header class="auth-head">
    <span class="step-indicator">Área do mentor</span>
    <% if @tab == "fila" %>
      <h2 class="screen-title">Na fila</h2>
      <p class="screen-desc">
        Vídeos esperando a sua devolutiva, de quem espera há mais tempo. Escreva no próprio
        cartão: depois de enviar, o vídeo vai para Todos.
      </p>
    <% else %>
      <h2 class="screen-title">Todos os vídeos</h2>
      <p class="screen-desc">
        Tudo o que os aprendizes enviaram, separado por pessoa. Dá para revisar as
        devolutivas que você escreveu. Só mentores veem esta página.
      </p>
    <% end %>
  </header>

  <% if @learners.empty? %>
    <div class="zine-empty">
      <span class="material-symbols-outlined auth-icon"><%= @tab == "fila" ? "task_alt" : "video_library" %></span>
      <p><%= @tab == "fila" ? "Nenhum vídeo esperando devolutiva." : "Nenhum aprendiz enviou vídeo ainda." %></p>
    </div>
  <% else %>
    <p class="auth-hint">
      <%= pluralize(@learners.size, "aprendiz", plural: "aprendizes") %>
      <%= "· de quem espera há mais tempo" if @tab == "fila" %>
    </p>

    <ol class="mentor-learners">
      <% @learners.each do |learner, training_sessions| %>
        <li class="mentor-learner" id="<%= dom_id(learner, :mentor) %>">
          <header class="mentor-learner-head">
            <span class="material-symbols-outlined">person</span>
            <div class="mentor-learner-name">
              <strong><%= link_to masked_contact(learner), mentor_learner_path(learner), class: "mentor-learner-link", title: "Ver o perfil do aprendiz" %></strong>
              <span class="auth-hint"><%= learner_summary(learner) %></span>
            </div>
            <% if learner.needs_supervision? %>
              <span class="guide-tag is-must">Menor de idade</span>
            <% end %>
            <%= link_to mentor_chat_path(learner), class: "mentor-chat-link", title: "Conversar com o aprendiz", aria: { label: "Conversar com o aprendiz" } do %>
              <span class="material-symbols-outlined">forum</span>
            <% end %>
          </header>

          <ol class="zine-list">
            <% training_sessions.each do |training_session| %>
              <% review = training_session.ai_review %>
              <li class="zine-card" id="<%= dom_id(training_session, :mentor) %>">
                <div class="zine-video">
                  <%= training_video_tag(training_session) %>
                </div>

                <div class="zine-body">
                  <div class="zine-title-row">
                    <h3><%= training_session.maneuver.name %></h3>
                    <span class="zine-code"><%= training_session.maneuver.code %></span>
                  </div>
                  <p class="auth-hint"><%= zine_clip_details(training_session) %></p>
                  <p class="zine-expiry <%= "is-soon" if clip_expiring_soon?(training_session) %>">
                    <span class="material-symbols-outlined" aria-hidden="true">auto_delete</span>
                    <%= clip_expiry_label(training_session) %>
                  </p>

                  <% if outcome_label(training_session) %>
                    <p class="mentor-outcome">Resultado declarado: <strong><%= outcome_label(training_session) %></strong></p>
                  <% end %>

                  <% if training_session.awaiting_review? %>
                    <p class="zine-status <%= overdue?(training_session) ? "error" : "info" %>">
                      <span class="material-symbols-outlined"><%= overdue?(training_session) ? "alarm" : "schedule" %></span>
                      <%= waiting_label(training_session) %>
                    </p>
                    <%# O mentor que o aprendiz escolheu: só ele responde, até passar o prazo. %>
                    <% if (chosen = training_session.mentor) %>
                      <p class="zine-status <%= chosen == current_user ? "ok" : "warn" %>">
                        <span class="material-symbols-outlined">school</span>
                        <span>
                          <% if chosen == current_user %>
                            O aprendiz escolheu você para avaliar este vídeo.
                          <% elsif training_session.open_to?(current_user) %>
                            Escolheu <%= mentor_name(chosen) %>, sem resposta em <%= TrainingSession::REVIEW_HOURS %>h: qualquer mentor pode responder.
                          <% else %>
                            Escolheu <%= mentor_name(chosen) %> para avaliar. Sem resposta em <%= TrainingSession::REVIEW_HOURS %>h, o vídeo vai para a sua fila.
                          <% end %>
                        </span>
                      </p>
                    <% end %>
                    <% if training_session.recorded_at_meetup? %>
                      <p class="zine-status info">
                        <span class="material-symbols-outlined">local_fire_department</span>
                        Vídeo de um rolê: ao responder, a sessão fica validada na ofensiva do aprendiz.
                      </p>
                    <% end %>

                    <%# Na fila, a devolutiva é escrita aqui mesmo; em Todos, leva até a fila. %>
                    <% if @tab == "fila" %>
                      <%= render "mentor/reviews/form", training_session: training_session, review: review %>
                    <% elsif training_session.open_to?(current_user) %>
                      <%= link_to mentor_zine_path(aba: "fila", anchor: dom_id(training_session, :mentor)), class: "auth-link review-go" do %>
                        <span class="material-symbols-outlined">rate_review</span> Responder na fila
                      <% end %>
                    <% end %>
                  <% else %>
                    <p class="zine-status ok">
                      <span class="material-symbols-outlined">check_circle</span>
                      <%= review_sent_label(review) %>
                    </p>
                    <div class="review-summary">
                      <strong><%= review.headline %></strong>
                      <p><span class="is-good">Fez bem:</span> <%= review.strengths %></p>
                      <p><span class="is-fix">Erro:</span> <%= review.mistake %></p>
                      <p><span class="is-focus">Foco:</span> <%= review.next_focus %></p>
                    </div>
                    <%# Só quem escreveu revisa (AiReview#revisable_by?). %>
                    <% if review.revisable_by?(current_user) %>
                      <details class="review-revise">
                        <summary><span class="material-symbols-outlined">edit</span> Revisar devolutiva</summary>
                        <%= render "mentor/reviews/form", training_session: training_session, review: review %>
                      </details>
                    <% else %>
                      <p class="zine-status info">
                        <span class="material-symbols-outlined">lock</span>
                        <span>
                          <% if review.reviewer %>Escrita por <%= mentor_name(review.reviewer) %>. <% end %>Só quem escreveu pode revisar.
                        </span>
                      </p>
                    <% end %>
                  <% end %>

                  <% if current_user.admin_access? %>
                    <%= render "clips/delete_button", training_session: training_session %>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ol>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>
