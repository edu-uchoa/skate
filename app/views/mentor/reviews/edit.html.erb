<% content_for :section, "Mentor" %>
<% learner = @training_session.user %>

<section class="auth-screen">
  <header class="auth-head">
    <%= link_to mentor_zine_path, class: "auth-back" do %>
      <span class="material-symbols-outlined">arrow_back</span> Voltar para a fila
    <% end %>
    <span class="step-indicator">Responder devolutiva</span>
    <h2 class="screen-title"><%= @training_session.maneuver.label %></h2>
  </header>

  <div class="video-container" style="margin: 0;">
    <%= training_video_tag(@training_session, style: "width: 100%; height: 100%; object-fit: contain;") %>
  </div>

  <div class="mentor-learner-head">
    <span class="material-symbols-outlined">person</span>
    <div class="mentor-learner-name">
      <strong><%= masked_contact(learner) %></strong>
      <span class="auth-hint">
        <%= [ learner_summary(learner).presence, ("Declarou: #{outcome_label(@training_session)}" if outcome_label(@training_session)), waiting_label(@review) ].compact.join(" · ") %>
      </span>
    </div>
    <% if learner.needs_supervision? %>
      <span class="guide-tag is-must">Menor de idade</span>
    <% end %>
  </div>

  <% if @training_session.recorded_at_meetup? %>
    <p class="zine-status info">
      <span class="material-symbols-outlined">local_fire_department</span>
      Vídeo de um rolê: ao responder, a sessão fica validada na ofensiva do aprendiz.
    </p>
  <% end %>

  <%= render "shared/errors", record: @review %>

  <%= form_with scope: :review, url: mentor_review_path(@review), method: :patch, class: "auth-form" do |f| %>
    <div class="auth-field">
      <%= f.label :headline, "Frase de destaque (opcional)", class: "auth-label" %>
      <%= f.text_field :headline, value: params.dig(:review, :headline), class: "auth-input", maxlength: AiReview::TEXT_LENGTH,
            placeholder: "Ex.: Seu rolamento já está quase lá!" %>
    </div>

    <% [
         [ :strengths,  "O que você fez bem",      "var(--tertiary-color)",  "check_circle",     "Comece pelo que deu certo." ],
         [ :mistake,    "Onde foi o erro",         "var(--secondary-color)", "warning",          "Um erro só, o mais importante." ],
         [ :next_focus, "Foco da próxima sessão",  "var(--primary-color)",   "tips_and_updates", "Um ajuste único e fácil de lembrar." ]
       ].each do |field, label, color, icon, placeholder| %>
      <div class="auth-field">
        <%= f.label field, class: "auth-label review-label", style: "color: #{color};" do %>
          <span class="material-symbols-outlined"><%= icon %></span> <%= label %>
        <% end %>
        <%= f.text_area field, value: params.dig(:review, field), rows: 3, required: true, maxlength: AiReview::TEXT_LENGTH,
              class: "auth-input", style: "border-color: #{color};", placeholder: placeholder %>
      </div>
    <% end %>

    <p class="auth-hint">O aprendiz vê exatamente estes três blocos, na tela de devolutiva dele. Fale como o amigo mais velho que já caiu, não como quem avalia.</p>
    <p class="auth-hint">Ao enviar, a tarefa <%= @training_session.maneuver.code %> fica concluída para o aprendiz e a seta da trilha dele vai para a próxima.</p>

    <%= f.button type: :submit, class: "tactile-btn-primary" do %>
      <span>Enviar devolutiva</span>
      <span class="material-symbols-outlined btn-arrow">send</span>
    <% end %>
  <% end %>

  <% if current_user.role_admin? %>
    <%= render "clips/delete_button", training_session: @training_session %>
  <% end %>
</section>
