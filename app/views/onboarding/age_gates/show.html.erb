<% content_for :section, "Segurança" %>

<section class="auth-screen">
  <header class="auth-head">
    <span class="material-symbols-outlined auth-icon">calendar_today</span>
    <span class="step-indicator">Segurança em primeiro lugar</span>
    <h2 class="screen-title">Qual é o seu ano de nascimento?</h2>
  </header>

  <%= render "shared/errors", record: @user %>

  <%= form_with model: @user, url: onboarding_age_gate_path, method: :patch, class: "auth-form" do |f| %>
    <div class="auth-field">
      <%= f.label :birth_year, "Ano de nascimento", class: "auth-label" %>
      <%= f.number_field :birth_year, class: "auth-input auth-input-code", inputmode: "numeric",
            placeholder: "2005", min: 1900, max: Date.current.year, required: true, autofocus: true %>
    </div>

    <div class="auth-card">
      <span class="auth-card-label">
        <span class="material-symbols-outlined" style="font-size: 15px; vertical-align: -3px;">policy</span>
        Termos de uso e segurança
      </span>
      <p class="sub-headline-body">
        O FlipaAi é restrito a maiores de <%= User::MINIMUM_AGE %> anos por regras de privacidade e
        segurança física. Se você tem entre 13 e 17 anos, certifique-se de treinar sob
        supervisão de um responsável.
      </p>
    </div>

    <%= f.button type: :submit, class: "tactile-btn-primary" do %>
      <span>Aceitar termos de uso e segurança</span>
      <span class="material-symbols-outlined btn-arrow">arrow_forward</span>
    <% end %>
  <% end %>

  <p class="auth-note">
    <span class="material-symbols-outlined" style="font-size: 15px;">lock</span>
    Usamos o ano só para confirmar a idade mínima.
  </p>
</section>
