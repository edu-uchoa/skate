<%# Sem cópia guardada para o "voltar": quem já terminou o cadastro cai na trilha (o servidor redireciona). %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<% content_for :section, "Plano" %>

<section class="auth-screen">
  <header class="auth-head">
    <span class="material-symbols-outlined auth-icon" style="font-size: 40px; color: var(--tertiary-color);">check_circle</span>
    <span class="step-indicator">Diagnóstico concluído • 100%</span>
    <h2 class="screen-title" style="font-size: 30px;">Entendido.</h2>
  </header>

  <div class="sub-headline-card" style="margin: 0;">
    <p class="sub-headline-title" style="text-transform: none; margin-bottom: 6px;"><%= @planner.summary %></p>
    <p class="sub-headline-body"><%= @planner.reassurance %></p>
  </div>

  <div class="auth-card">
    <span class="auth-card-label">Seu ponto de partida na trilha</span>
    <span class="auth-card-value"><%= @planner.entry_maneuver.label %></span>
  </div>

  <% if @planner.recommended_drills.any? %>
    <div class="auth-card">
      <span class="auth-card-label">Recomendado para você</span>
      <ul class="card-list">
        <% @planner.recommended_drills.each do |drill| %>
          <li>
            <span class="card-list-label">
              <span class="material-symbols-outlined">bolt</span>
              <%= drill.label %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= link_to maneuver_path(@planner.entry_maneuver), class: "tactile-btn-primary" do %>
    <span>Ver meu primeiro passo</span>
    <span class="material-symbols-outlined btn-arrow">arrow_forward</span>
  <% end %>
</section>
