<% content_for :section, "Diagnóstico" %>
<div style="position: relative;">
  <span class="step-indicator">PASSO 2 DE 3 • 66%</span>
  <div class="version-badge" style="top: -6px; right: 0; background: #fd591e; color: black; font-weight: 800; font-size: 9px; padding: 2px 6px;">PODE MARCAR VÁRIAS</div>
</div>
<h2 class="screen-title" style="font-family: 'Outfit', sans-serif;">O que é mais difícil hoje?</h2>

<%= form_with model: @diagnosis, url: onboarding_diagnosis_path(step: "blockers"), method: :patch, class: "options-list", style: "margin-top: 8px;" do |f| %>
  <%= hidden_field_tag "diagnosis[blockers][]", "" %>

  <% options = [
       { val: "fear_of_falling", icon: "healing", title: "Medo de cair e me machucar", desc: "Aquele receio de cair de mau jeito e forçar o punho no chão." },
       { val: "shame", icon: "visibility_off", title: "Vergonha de treinar na frente dos outros", desc: "Ficar travado porque a galera que já sabe andar fica olhando." },
       { val: "foot_technique", icon: "skateboarding", title: "Não sei qual o movimento certo do pé", desc: "Não saber onde encaixar o pé de base e como bater o tail com firmeza." },
       { val: "no_place", icon: "location_off", title: "Falta de lugar adequado e vazio", desc: "Não ter uma garagem lisa ou quadra sem movimento perto de casa." }
     ] %>

  <div style="display: flex; flex-direction: column; gap: 8px; width: 100%;">
    <% options.each do |opt| %>
      <% is_checked = @diagnosis.blocker_kinds.include?(opt[:val]) %>
      <label class="sub-headline-card option-card <%= is_checked ? 'selected' : '' %>" style="transform: none; background: #1a1b20; border: 1px solid <%= is_checked ? '#ffb800' : '#343538' %>; padding: 10px; cursor: pointer; transition: all 0.2s;" onclick="toggleCheckCard(this)">
        <%= check_box_tag "diagnosis[blockers][]", opt[:val], is_checked, id: "blocker_#{opt[:val]}", class: "sr-only", style: "position: absolute; opacity: 0; pointer-events: none;" %>
        
        <div style="display: flex; gap: 10px; align-items: flex-start;">
          <span class="material-symbols-outlined" style="color: #ffb800; margin-top: 2px;"><%= opt[:icon] %></span>
          <div style="font-family: 'Inter', sans-serif;">
            <h3 style="font-size: 13px; font-weight: bold; color: #e3e2e6; margin: 0;"><%= opt[:title] %></h3>
            <p style="font-size: 11px; color: #d5c4ab; margin: 0; line-height: 1.4;"><%= opt[:desc] %></p>
          </div>
        </div>
      </label>
    <% end %>
  </div>

  <script>
    function toggleCheckCard(element) {
      const checkbox = element.querySelector('input[type="checkbox"]');
      // Set a short timeout to let the default behavior happen first if clicked directly on input
      setTimeout(() => {
        if (checkbox.checked) {
          element.style.borderColor = '#ffb800';
          element.classList.add('selected');
        } else {
          element.style.borderColor = '#343538';
          element.classList.remove('selected');
        }
      }, 10);
    }
  </script>

  <div style="margin-top: auto; padding-top: 14px;">
    <%= f.button type: :submit, class: "tactile-btn-primary", style: "width: 100%; font-family: 'Outfit', sans-serif; display: flex; justify-content: center; align-items: center;" do %>
      <span>Avançar para o Passo 3</span>
      <span class="material-symbols-outlined">arrow_forward</span>
    <% end %>
  </div>
<% end %>
