<% content_for :section, "Segurança" %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
  <span class="tape-badge" style="background: #ffb800; color: black; font-size: 10px; font-weight: 800; padding: 3px 8px; border-radius: 4px; text-transform: uppercase;">🛡 MODO TREINO OFFLINE</span>
</div>
<h2 class="screen-title" style="font-family: 'Outfit', sans-serif;">Checklist Pré-Sessão</h2>
<p class="screen-desc" style="font-family: 'Inter', sans-serif;">Marque os itens antes de subir no skate para garantir um treino seguro.</p>

<%= render "shared/errors", record: @training_session %>

<%= form_with model: @training_session,
      url: maneuver_training_sessions_path(@maneuver),
      data: { controller: "checklist" },
      style: "display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px;" do |f| %>

  <% {
       gear_checked: "Capacete e joelheiras bem firmes?",
       ground_clear: "O chão está plano e sem pedrinhas?",
       space_safe:   "Ambiente seguro e livre de perigos?"
     }.each do |attribute, question| %>
    <div class="check-item" onclick="this.classList.toggle('done')" style="display: flex; align-items: center; gap: 10px; background: #1a1b20; border: 1px solid #343538; border-radius: 8px; padding: 10px; cursor: pointer; transition: all 0.2s;">
      <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; width: 100%;">
        <div class="check-box-square" style="width: 28px; height: 28px; border-radius: 6px; background: #24252a; border: 2px solid #343538; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
          <span class="material-symbols-outlined" style="font-size: 16px; color: #ffb800;">check</span>
        </div>
        <%= f.check_box attribute, style: "position: absolute; opacity: 0; pointer-events: none;",
              data: { checklist_target: "item", action: "checklist#refresh" } %>
        <span style="font-size: 12px; font-weight: bold; color: #e3e2e6; font-family: 'Inter', sans-serif;"><%= question %></span>
      </label>
    </div>
  <% end %>

  <div style="display: flex; flex-direction: column; gap: 8px; margin-top: auto; padding-top: 14px;">
    <%= f.button type: :submit, class: "tactile-btn-primary", style: "width: 100%; background: #ff5a5f; color: black; box-shadow: 0 4px 0 #690005; font-family: 'Outfit', sans-serif; display: flex; justify-content: center; align-items: center; gap: 6px;", data: { checklist_target: "submit" } do %>
      <span class="material-symbols-outlined">videocam</span>
      <span style="font-weight: 800;">Gravar 15s de Vídeo Direto</span>
    <% end %>

    <%= f.button type: :submit, class: "secondary-link-btn", style: "text-align: center; display: block; width: 100%; border: none; background: transparent; cursor: pointer;", data: { checklist_target: "submit" } do %>
      Registrar sem enviar vídeo
    <% end %>
  </div>
<% end %>
