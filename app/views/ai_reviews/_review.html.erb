<div class="step-indicator" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
  <span class="tape-badge" style="background: #fd591e; color: black; font-size: 10px; font-weight: 800; padding: 3px 8px; border-radius: 4px; text-transform: uppercase; font-family: 'Outfit', sans-serif;">🤖 ANÁLISE DA IA</span>
</div>

<% if ai_review.status_failed? %>
  <h2 class="screen-title" style="font-family: 'Outfit', sans-serif; color: #ff5a5f;">Não conseguimos analisar</h2>
  <div class="sub-headline-card" style="border-left: 4px solid #ff5a5f; transform: none; background: #1a1b20; padding: 10px; margin-bottom: 10px;">
    <p style="font-size: 12px; color: #d5c4ab; line-height: 1.4; font-family: 'Inter', sans-serif;">
      Isso não afeta seu progresso. Você pode tentar de novo no próximo treino.
    </p>
  </div>
<% else %>
  <h2 class="screen-title" style="font-family: 'Outfit', sans-serif;"><%= ai_review.headline %></h2>
  
  <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; margin-top: 10px;">
    <!-- Feedback: O que fez bem -->
    <div style="background: #1a1b20; border: 1px solid #30D158; border-radius: 8px; padding: 10px; position: relative; overflow: hidden;">
      <div style="font-size: 9px; font-weight: 800; color: #30D158; text-transform: uppercase; margin-bottom: 4px; font-family: 'Inter', sans-serif; display: flex; align-items: center; gap: 4px;">
        <span class="material-symbols-outlined" style="font-size: 14px;">check_circle</span> O QUE VOCÊ FEZ BEM
      </div>
      <p style="font-size: 12px; color: #e3e2e6; margin: 0; font-family: 'Inter', sans-serif; line-height: 1.4;"><%= ai_review.strengths %></p>
    </div>

    <!-- Feedback: Onde foi o erro -->
    <div style="background: #1a1b20; border: 1px solid #fd591e; border-radius: 8px; padding: 10px; position: relative; overflow: hidden;">
      <div style="font-size: 9px; font-weight: 800; color: #fd591e; text-transform: uppercase; margin-bottom: 4px; font-family: 'Inter', sans-serif; display: flex; align-items: center; gap: 4px;">
        <span class="material-symbols-outlined" style="font-size: 14px;">warning</span> ONDE FOI O ERRO
      </div>
      <p style="font-size: 12px; color: #e3e2e6; margin: 0; font-family: 'Inter', sans-serif; line-height: 1.4;"><%= ai_review.mistake %></p>
    </div>

    <!-- Feedback: Próxima sessão -->
    <div style="background: #1a1b20; border: 1px solid #ffb800; border-radius: 8px; padding: 10px; position: relative; overflow: hidden;">
      <div style="font-size: 9px; font-weight: 800; color: #ffb800; text-transform: uppercase; margin-bottom: 4px; font-family: 'Inter', sans-serif; display: flex; align-items: center; gap: 4px;">
        <span class="material-symbols-outlined" style="font-size: 14px;">tips_and_updates</span> FOCO DA PRÓXIMA SESSÃO
      </div>
      <p style="font-size: 12px; color: #e3e2e6; margin: 0; font-family: 'Inter', sans-serif; line-height: 1.4;"><%= ai_review.next_focus %></p>
    </div>
  </div>
<% end %>

<div style="margin-top: auto; display: flex; flex-direction: column; gap: 8px; padding-top: 6px;">
  <%= link_to track_path, class: "tactile-btn-primary", style: "display: flex; justify-content: center; align-items: center; gap: 6px; text-decoration: none; font-family: 'Outfit', sans-serif;" do %>
    <span style="font-weight: 800;">Aplicar Ajuste e Ir p/ Trilha</span>
    <span class="material-symbols-outlined">arrow_forward</span>
  <% end %>
  <%= link_to new_schedule_path, class: "secondary-link-btn", style: "text-align: center; display: block;" do %>
    Agendar próxima sessão
  <% end %>
</div>
