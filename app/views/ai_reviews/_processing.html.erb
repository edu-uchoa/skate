<div style="flex: 1; display: flex; flex-direction: column;" data-controller="poll" data-poll-interval-value="4000">
  <div style="position: relative; width: 100%; aspect-ratio: 4/5; background: #0d0e11; overflow: hidden; border-bottom: 2px solid #343538;">
    <img src="<%= asset_path('skater_hero.jpg') %>" alt="Processando" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.5;">
    
    <!-- Scanner Line Animation -->
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: #ffb800; box-shadow: 0 0 12px #ffb800; animation: scan 2s linear infinite;"></div>
    
    <!-- HUD Tracking Points -->
    <div style="position: absolute; top: 38%; left: 45%; width: 12px; height: 12px; border-radius: 50%; border: 2px solid #ffb800; box-shadow: 0 0 8px #ffb800; animation: pulse 1s infinite;">
      <div style="position: absolute; width: 30px; height: 1px; background: #ffb800; top: 5px; left: 10px; transform: rotate(-30deg);"></div>
    </div>
    <div style="position: absolute; top: 62%; left: 56%; width: 12px; height: 12px; border-radius: 50%; border: 2px solid #30D158; box-shadow: 0 0 8px #30D158; animation: pulse 1s infinite;"></div>
    
    <div class="version-badge" style="top: 8px; left: 8px; background: #ffb800; color: black; font-size: 10px;">SCANNER BIOMECÂNICO</div>
    <div class="version-badge" style="bottom: 8px; right: 8px; background: rgba(31,31,35,0.9); color: #30D158; font-size: 9px; border-color: #30D158;">PROCESSANDO</div>

    <style>
      @keyframes scan {
        0% { top: 0; }
        50% { top: 100%; }
        100% { top: 0; }
      }
      @keyframes pulse {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.5); opacity: 0.5; }
        100% { transform: scale(1); opacity: 1; }
      }
      @keyframes spin { 100% { transform: rotate(360deg); } }
    </style>
  </div>

  <div style="padding: 14px; display: flex; flex-direction: column; flex: 1;">
    <div class="sub-headline-card" style="transform: none; background: #1a1b20; border: 1px solid #343538; padding: 12px; margin-bottom: 10px;">
      <h3 style="font-family: 'Outfit', sans-serif; font-size: 13px; font-weight: bold; color: #e3e2e6; text-transform: uppercase; margin-bottom: 8px;">Log de Análise</h3>
      <ul style="list-style: none; display: flex; flex-direction: column; gap: 6px; font-size: 11px; color: #d5c4ab; font-family: 'Inter', sans-serif; padding: 0;">
        <li style="display: flex; align-items: center; gap: 6px;">
          <span class="material-symbols-outlined" style="color: #30D158; font-size: 16px;">check_circle</span>
          Upload de vídeo concluído
        </li>
        <li style="display: flex; align-items: center; gap: 6px;">
          <span class="material-symbols-outlined" style="color: #30D158; font-size: 16px;">check_circle</span>
          Mapeamento de articulações
        </li>
        <li style="display: flex; align-items: center; gap: 6px;">
          <span class="material-symbols-outlined" style="color: #ffb800; font-size: 16px; animation: spin 2s linear infinite;">settings</span>
          <span style="color: #ffb800;">Analisando postura e impacto...</span>
        </li>
      </ul>
    </div>

    <div style="margin-top: auto; display: flex; flex-direction: column; gap: 6px;">
      <%= link_to track_path, class: "secondary-link-btn", style: "text-align: center; display: block;" do %>
        Aguardar na Trilha
      <% end %>
    </div>
  </div>
</div>
