<%# Espera pela devolutiva: o vídeo fica na fila do mentor (ainda não há análise automática).
    Atualiza a cada minuto; a resposta pode levar até 48h, então não precisa ser mais rápido. %>
<% training_session = ai_review.training_session %>
<% watching = ai_review.status_processing? %>

<section class="auth-screen" data-controller="poll" data-poll-interval-value="60000">
  <header class="auth-head">
    <span class="step-indicator">Devolutiva do mentor</span>
    <h2 class="screen-title"><%= watching ? "O mentor está vendo seu vídeo" : "Seu vídeo está na fila do mentor" %></h2>
    <p class="screen-desc">
      Um mentor vai assistir ao seu <%= training_session.maneuver.name.downcase %> e responder em até 48 horas.
      Enquanto isso, siga na trilha: o seu progresso não depende da resposta.
    </p>
  </header>

  <% if training_session.clip.attached? %>
    <div class="video-container" style="margin: 0;">
      <%= training_video_tag(training_session, style: "width: 100%; height: 100%; object-fit: cover;") %>
    </div>
  <% end %>

  <div class="auth-card">
    <span class="auth-card-label">O que você vai receber</span>
    <ul class="card-list">
      <li><span class="card-list-label"><span class="material-symbols-outlined" style="color: var(--tertiary-color);">check_circle</span> O que você fez bem</span></li>
      <li><span class="card-list-label"><span class="material-symbols-outlined" style="color: var(--secondary-color);">warning</span> Onde foi o erro</span></li>
      <li><span class="card-list-label"><span class="material-symbols-outlined">tips_and_updates</span> O foco da próxima sessão</span></li>
    </ul>
  </div>

  <%= link_to track_path, class: "tactile-btn-primary" do %>
    <span>Seguir na trilha</span>
    <span class="material-symbols-outlined btn-arrow">arrow_forward</span>
  <% end %>

  <p class="auth-note">
    <span class="material-symbols-outlined" style="font-size: 15px;">lock</span>
    Só você e o mentor veem este vídeo.
  </p>
</section>
