<% content_for :section, "Loja" %>

<span class="step-indicator">MOEDAS E RESGATES</span>

<div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 12px; margin-top: 6px;">
  <span class="screen-title" style="font-family: 'Outfit', sans-serif; font-size: 26px; line-height: 1; font-weight: 800; color: #ffb800; text-transform: uppercase;">🎯 Sequência & Resgates</span>
  <div class="version-badge" style="position: static; transform: rotate(-2deg); background: #ffb800; color: black; font-weight: 800; font-size: 10px;">
    🪙 450 MOEDAS STANCE
  </div>
</div>

<div class="sub-headline-card" style="position: relative; background: #1a1b20; border: 1px solid #343538; padding: 14px; margin-bottom: 12px; transform: none; box-shadow: 4px 4px 0 #121316;">
  <div class="version-badge" style="top: -8px; right: -6px; background: #fd591e; color: black; font-weight: 800; font-size: 9px; transform: rotate(4deg); position: absolute;">
    Recorde Pessoal!
  </div>
  
  <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 10px;">
    <div style="width: 54px; height: 54px; border-radius: 50%; overflow: hidden; border: 2px solid #ffb800; box-shadow: 0 0 12px rgba(255, 184, 0, 0.4); flex-shrink: 0;">
      <img src="<%= asset_path 'skate_wheel_streak.jpg' %>" alt="Roda de Skate Ofensiva" style="width: 100%; height: 100%; object-fit: cover;">
    </div>
    <div>
      <h2 style="font-family: 'Outfit', sans-serif; font-size: 22px; font-weight: 900; color: #ffb800; line-height: 1;">14 DIAS</h2>
      <span style="font-size: 11px; font-weight: 800; color: #e3e2e6; text-transform: uppercase;">De Ofensiva 🔥 Roda Aquecida</span>
    </div>
  </div>

  <p style="font-size: 12px; color: #d5c4ab; margin-bottom: 10px; font-family: 'Inter', sans-serif;">Bora treinar hoje para manter o embalo?</p>

  <div style="display: flex; justify-content: space-between; background: #0d0e11; padding: 6px 8px; border-radius: 6px; border: 1px solid #292a2d;">
    <% ["D", "S", "T", "Q"].each do |day| %>
      <div style="display: flex; flex-direction: column; align-items: center; gap: 3px;">
        <span style="font-size: 9px; color: #9e8f78; font-weight: bold;"><%= day %></span>
        <div style="width: 26px; height: 26px; background: #ffb800; color: black; font-weight: bold; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 12px;">✓</div>
      </div>
    <% end %>
    <div style="display: flex; flex-direction: column; align-items: center; gap: 3px;">
      <span style="font-size: 9px; color: #ffb800; font-weight: bold;">Q</span>
      <div style="width: 26px; height: 26px; border: 2px dashed #ffb800; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #ffb800; animation: pulse 1s infinite;">HOJE</div>
    </div>
    <% ["S", "S"].each do |day| %>
      <div style="display: flex; flex-direction: column; align-items: center; gap: 3px;">
        <span style="font-size: 9px; color: #514532; font-weight: bold;"><%= day %></span>
        <div style="width: 26px; height: 26px; background: #1f1f23; border: 1px solid #343538; border-radius: 4px;"></div>
      </div>
    <% end %>
  </div>
</div>

<h3 style="font-family: 'Outfit', sans-serif; font-size: 14px; font-weight: 800; text-transform: uppercase; margin-bottom: 6px;">Metas de Constância</h3>
<div style="position: relative; height: 80px; border-radius: 8px; overflow: hidden; border: 1px solid #343538; margin-bottom: 12px; box-shadow: 3px 3px 0 #121316;">
  <img src="<%= asset_path 'skate_track_milestones.jpg' %>" alt="Pista Skate 3" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.75;">
  <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(18,19,22,0.92), transparent); display: flex; align-items: flex-end; padding: 6px 10px; justify-content: space-between;">
    <span style="font-size: 10px; color: #30D158; font-weight: 900; font-family: 'Inter', sans-serif;">✓ 10 DIAS (Liberado)</span>
    <span style="font-size: 10px; color: #ffb800; font-weight: 900; font-family: 'Inter', sans-serif;">50 DIAS (Em Progresso)</span>
    <span style="font-size: 10px; color: #9e8f78; font-weight: 900; font-family: 'Inter', sans-serif;">100 DIAS 🔒</span>
  </div>
</div>

<h3 style="font-family: 'Outfit', sans-serif; font-size: 14px; font-weight: 800; text-transform: uppercase; margin-bottom: 6px; display: flex; justify-content: space-between;">
  <span>Loja de Resgate</span>
  <span style="color: #ffb800; font-size: 11px;">Parceiros Oficiais</span>
</h3>

<div style="display: flex; flex-direction: column; gap: 8px; padding-bottom: 10px; font-family: 'Inter', sans-serif;">
  <div style="display: flex; background: #1a1b20; border: 1px solid #343538; border-radius: 6px; padding: 8px 10px; justify-content: space-between; align-items: center; box-shadow: 2px 2px 0 #121316;">
    <div>
      <h4 style="font-size: 13px; font-weight: 800; color: #e3e2e6; margin: 0;">15% OFF em Lixas</h4>
      <p style="font-size: 10px; color: #ffb800; font-weight: bold; margin: 0;">Over Street</p>
    </div>
    <button class="tactile-btn-primary" style="padding: 6px 10px; font-size: 11px; width: auto; margin: 0; font-family: 'Outfit', sans-serif;" onclick="alert('Cupom OVERSTREET15 resgatado!')">
      300 🪙 Resgatar
    </button>
  </div>

  <div style="display: flex; background: #1a1b20; border: 1px solid #343538; border-radius: 6px; padding: 8px 10px; justify-content: space-between; align-items: center; box-shadow: 2px 2px 0 #121316; opacity: 0.7;">
    <div>
      <h4 style="font-size: 13px; font-weight: 800; color: #e3e2e6; margin: 0;">Frete Grátis</h4>
      <p style="font-size: 10px; color: #9e8f78; margin: 0;">Kings Sneakers</p>
    </div>
    <button class="tactile-btn-primary" style="padding: 6px 10px; font-size: 11px; width: auto; background: #343538; color: #9e8f78; box-shadow: none; margin: 0; font-family: 'Outfit', sans-serif;" disabled>
      500 🔒 Bloqueado
    </button>
  </div>
</div>

<div style="margin-top: auto; padding-top: 8px; padding-bottom: 24px;">
  <%= link_to onboarding_diagnosis_path, class: "tactile-btn-primary", style: "display: flex; justify-content: center; align-items: center; gap: 6px; text-decoration: none; font-family: 'Outfit', sans-serif;" do %>
    <span style="font-weight: 800;">Continuar para o Teste</span>
    <span class="material-symbols-outlined">arrow_forward</span>
  <% end %>
</div>
