<% content_for :section, "Verificação" %>

<%= link_to new_account_path, class: "mb-md inline-flex items-center gap-xs text-on-surface-variant" do %>
  <span class="material-symbols-outlined">arrow_back</span> Voltar
<% end %>

<h2 class="font-display text-headline-md">Verifique seu acesso</h2>
<p class="mt-xs text-body-md text-on-surface-variant">
  Enviamos um código de <%= AccessCode::LENGTH %> dígitos para
  <strong class="text-on-surface"><%= @access_code.destination %></strong>.
</p>

<%= form_with url: access_code_path, method: :post, class: "mt-md space-y-md" do %>
  <%= text_field_tag :code, nil, class: "field text-center font-display text-display-lg tracking-[0.4em]",
        inputmode: "numeric", autocomplete: "one-time-code", maxlength: AccessCode::LENGTH,
        pattern: "\\d{#{AccessCode::LENGTH}}", required: true, autofocus: true %>

  <%= submit_tag "Confirmar e salvar", class: "btn-primary" %>
<% end %>

<div class="mt-md text-center" data-controller="countdown" data-countdown-seconds-value="30">
  <p class="text-body-md text-on-surface-variant" data-countdown-target="label"></p>
  <%= button_to "Reenviar código", resend_access_code_path, method: :post,
        class: "btn-tertiary mt-xs hidden", data: { countdown_target: "action" } %>
</div>
