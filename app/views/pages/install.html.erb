<% content_for :section, "Instalação" %>

<div style="position: relative; width: 100%; height: 160px; background: linear-gradient(135deg, #1f1f23, #0d0e11); border-radius: 12px; border: 1px solid #343538; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; box-shadow: 4px 4px 0 #121316; overflow: hidden;">
  <div style="width: 140px; height: auto;">
    <img src="<%= asset_path('stance_logo_oficial.svg') %>" alt="STANCE Logo Oficial" style="width: 100%; height: auto; object-fit: contain; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.8));">
  </div>
  <div class="version-badge" style="top: 8px; right: 8px; background: #ffb800; color: black; font-size: 9px;">PWA OFICIAL</div>
</div>

<div class="flex flex-col gap-1 mb-2">
  <h1 class="main-headline" style="font-size: 26px; line-height: 28px;">
    Adicione o <span style="color: #ffb800;">Stance</span><br>à sua tela inicial
  </h1>
</div>

<div class="sub-headline-card" style="border-left: 4px solid #fd591e; transform: none; background: #1a1b20; margin-bottom: 10px; padding: 10px;">
  <p style="font-size: 12px; color: #d5c4ab; line-height: 1.4;">
    Evite que o navegador apague seu progresso após uma semana. É rápido, leve e você treina sem precisar ir para a App Store.
  </p>
</div>

<div id="os-instructions-container" class="sub-headline-card" style="transform: none; margin-bottom: 12px; display: flex; align-items: center; gap: 10px; background: #1a1b20; border: 1px solid #343538; padding: 10px;">
  <div style="width: 38px; height: 38px; border-radius: 50%; background: #292a2d; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
    <span id="os-icon" class="material-symbols-outlined" style="color: #ffdca1; font-size: 20px;">ios_share</span>
  </div>
  <p id="os-text" style="font-size: 12px; color: #e3e2e6; line-height: 1.35;">
    No iPhone: Toque em <strong>Compartilhar</strong> e depois em <strong style="color: #ffb800;">"Adicionar à Tela de Início"</strong>.
  </p>
</div>

<div style="margin-top: auto; display: flex; flex-direction: column; gap: 8px;">
  <%= link_to store_path, class: "tactile-btn-primary", style: "background-color: #1a1b20; color: #f5f5f7; border: 2px solid #343538; box-shadow: 0 4px 0 #0d0e11; transform: rotate(-1deg); justify-content: center; align-items: center; display: flex;" do %>
    <span style="font-weight: 800; margin-right: 8px;">Adicionar Atalho</span>
    <span class="material-symbols-outlined" style="color: #ffb800;">add_to_home_screen</span>
  <% end %>
  <%= link_to store_path, class: "secondary-link-btn", style: "text-align: center; display: block;" do %>
    Continuar no navegador por enquanto
  <% end %>
</div>
