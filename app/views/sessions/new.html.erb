<% content_for :section, "Entrar com senha" %>
<%# Só para contas antigas, com e-mail ou telefone e senha (mentores e administradores,
    até a versão web deles). Fica em /entrar/senha, sem link no app: quem usa o app
    entra pela tela da logo, com o Google. %>

<section class="auth-screen">
  <header class="auth-head">
    <%= link_to root_path, class: "auth-back" do %>
      <span class="material-symbols-outlined">arrow_back</span> Voltar
    <% end %>
    <span class="material-symbols-outlined auth-icon">key</span>
    <h2 class="screen-title">Conta antiga</h2>
    <p class="screen-desc">Entre com o e-mail ou telefone e a senha. Depois, ligue a conta ao Google no Perfil: o histórico continua todo lá.</p>
  </header>

  <%= form_with url: session_path, method: :post, scope: :session, class: "auth-form" do |f| %>
    <div class="auth-field">
      <%= f.label :contact, "E-mail ou telefone (WhatsApp)", class: "auth-label" %>
      <%= f.text_field :contact, value: params.dig(:session, :contact), class: "auth-input", required: true,
            autocomplete: "username", autocapitalize: "none", spellcheck: false,
            placeholder: "voce@email.com ou (61) 90000-0000" %>
    </div>

    <div class="auth-field">
      <%= f.label :password, "Senha", class: "auth-label" %>
      <%= f.password_field :password, class: "auth-input", required: true,
            autocomplete: "current-password", placeholder: "Sua senha" %>
    </div>

    <%= f.button type: :submit, class: "auth-secondary-btn" do %>
      <span>Entrar com senha</span>
    <% end %>
  <% end %>

  <%= link_to "Esqueci minha senha", new_password_reset_path, class: "auth-muted-link" %>
</section>
