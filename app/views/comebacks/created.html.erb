<% content_for :section, "Retorno" %>

<section class="auth-screen">
  <header class="auth-head">
    <span class="material-symbols-outlined auth-icon" style="font-size: 40px;">favorite</span>
    <h2 class="screen-title">Sem problemas</h2>
    <p class="screen-desc">
      Não cobramos consistência forçada aqui. Vamos começar com sessões rápidas de aquecimento
      em manobras que você já domina.
    </p>
  </header>

  <% if @warmups.any? %>
    <div class="auth-card">
      <span class="auth-card-label">Aquecimento sugerido</span>
      <ul class="card-list">
        <% @warmups.each do |maneuver| %>
          <li>
            <span class="card-list-label">
              <span class="material-symbols-outlined">local_fire_department</span>
              <%= maneuver.label %>
            </span>
            <%= link_to "Aquecer", maneuver_path(maneuver), class: "auth-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= link_to track_path, class: "tactile-btn-primary" do %>
    <span>Bora aquecer</span>
    <span class="material-symbols-outlined btn-arrow">arrow_forward</span>
  <% end %>
</section>
