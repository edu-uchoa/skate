<% content_for :section, "Trilha" %>

<div class="map-header" style="display: flex; justify-content: space-between; align-items: flex-start; padding: 16px; background: #121316; border-bottom: 1px solid #292a2d;">
  <div>
    <span class="map-tag" style="font-family: 'Inter', sans-serif; font-size: 9px; font-weight: 800; color: #d5c4ab; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 2px;">MAPA DE RUA • OVERWORLD</span>
    <h3 style="color: #ffb800; font-size: 16px; font-weight: 900; font-family: 'Outfit', sans-serif; margin: 0; text-transform: uppercase;">
      <% if @learning_modules.any? %>
        <%= @learning_modules.first.name %>
      <% else %>
        DISTRITO 1 • BASE & RUA
      <% end %>
    </h3>
  </div>
  <div style="display: flex; gap: 6px; align-items: center;">
    <div class="streak-pill" style="background: #24252a; border: 1px solid #343538; border-radius: 12px; padding: 4px 10px; display: flex; align-items: center; gap: 4px;">
      <span style="font-size: 10px; font-weight: 800; color: #ffb800;">🔥 14D</span>
    </div>
  </div>
</div>

<div class="overworld-map-viewport" data-controller="track-map">
  <div class="overworld-map-canvas" style="aspect-ratio: <%= map_aspect_ratio %>;">
    <img src="<%= asset_path("skate_overworld_map.jpg") %>" alt="Mapa de Rua" class="map-graphic-img" draggable="false">

    <% @learning_modules.flat_map(&:maneuvers).each_with_index do |maneuver, index| %>
      <% status = progression.status_for(maneuver) %>
      <% current = (maneuver == @current_maneuver) %>
      <%# Check só para o que foi treinado; liberado (inclusive pulado pelo diagnóstico) = cadeado aberto. %>
      <% state = if status == "completed" then "is-completed"
                 elsif current then "is-current"
                 elsif status != "locked" then "is-open"
                 end %>

      <%= link_to maneuver_path(maneuver), class: ["map-node", state], style: map_node_position(index),
                  title: maneuver.label, aria: { label: maneuver.label },
                  data: ({ track_map_target: "current" } if current) do %>
        <% if status == "completed" %>
          <span class="material-symbols-outlined">check</span>
        <% elsif current %>
          <span class="material-symbols-outlined">play_arrow</span>
        <% elsif status == "locked" %>
          <span class="material-symbols-outlined">lock</span>
        <% else %>
          <span class="material-symbols-outlined">lock_open</span>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

<% if @current_maneuver %>
  <div class="floating-lesson-card" style="position: relative; flex-shrink: 0; margin-top: 10px; background: #1a1b20; border: 2px solid #343538; border-radius: 12px; padding: 14px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 8px 24px rgba(0,0,0,0.8); z-index: 20;">
    <div class="lesson-info" style="flex: 1; padding-right: 10px;">
      <span class="lesson-step" style="font-family: 'Inter', sans-serif; font-size: 9px; font-weight: 800; color: #ffb800; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
        MÓDULO ATUAL • <%= @current_maneuver.label %>
      </span>
      <h4 class="lesson-name" style="font-family: 'Outfit', sans-serif; font-size: 15px; font-weight: 900; color: #e3e2e6; margin: 0; line-height: 1.2;">
        <%= @current_maneuver.description.truncate(45) %>
      </h4>
    </div>
    <%= link_to maneuver_path(@current_maneuver), class: "tactile-btn-primary", style: "padding: 10px 14px; font-size: 12px; width: auto; font-family: 'Outfit', sans-serif; display: flex; align-items: center; gap: 4px; text-decoration: none;" do %>
      <span style="font-weight: 800;">Treinar</span>
      <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
    <% end %>
  </div>
<% end %>
