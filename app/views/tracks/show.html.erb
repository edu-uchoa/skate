<% content_for :section, "Trilha" %>

<div class="map-header" style="display: flex; justify-content: space-between; align-items: flex-start; padding: 16px; background: #121316; border-bottom: 1px solid #292a2d;">
  <div>
    <span class="map-tag" style="font-family: 'Inter', sans-serif; font-size: 9px; font-weight: 800; color: #d5c4ab; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 2px;">MAPA DE RUA • OVERWORLD</span>
    <h3 style="color: #ffb800; font-size: 16px; font-weight: 900; font-family: 'Outfit', sans-serif; margin: 0; text-transform: uppercase;">
      <% if @learning_modules.any? %>
        <%= @learning_modules.first.name %>
      <% else %>
        DISTRITO 1 • BASE & RUA
      <% end %>
    </h3>
  </div>
  <div style="display: flex; gap: 6px; align-items: center;">
    <%# Ofensiva de verdade (Streak): sessões de skate comprovadas. Some quando é zero. %>
    <% if @streak.positive? %>
      <%= link_to streak_path, class: "streak-pill", title: "Ofensiva: #{streak_sessions_label(@streak)}",
            style: "background: #24252a; border: 1px solid #343538; border-radius: 12px; padding: 4px 10px; display: flex; align-items: center; gap: 4px; text-decoration: none;" do %>
        <span style="font-size: 10px; font-weight: 800; color: #ffb800;">🔥 <%= @streak %></span>
      <% end %>
    <% end %>
  </div>
</div>

<%# Mapa desenhado no app (TracksHelper#track_map_layout): desce de cima para baixo e
    rola na vertical, com a barra de rolagem à direita. %>
<% layout = track_map_layout(@learning_modules) %>
<div class="track-map-frame">
  <div class="track-map" data-controller="track-map">
    <div class="track-map-canvas" style="aspect-ratio: <%= TracksHelper::MAP_WIDTH %> / <%= layout.height %>;">
      <h3 class="map-title" aria-label="<%= TracksHelper::MAP_TITLE %>">
        <% map_title_lines.each do |line| %>
          <span class="map-title-line"><%= line %></span>
        <% end %>
      </h3>

      <% layout.districts.each do |district| %>
        <div class="map-street" style="<%= map_top(district.y, layout) %>" aria-hidden="true"></div>
      <% end %>

      <svg class="map-road" viewBox="0 0 <%= TracksHelper::MAP_WIDTH %> <%= layout.height %>" aria-hidden="true">
        <path class="map-road-edge" d="<%= layout.road_path %>" />
        <path class="map-road-asphalt" d="<%= layout.road_path %>" />
        <path class="map-road-line" d="<%= layout.road_path %>" />
      </svg>

      <% layout.districts.each do |district| %>
        <span class="map-sign is-<%= district.sign_side %>" style="<%= map_top(district.y, layout) %>">
          Módulo <%= district.learning_module.code %> · <%= district.learning_module.name %>
        </span>
      <% end %>

      <span class="map-flag is-start" style="<%= map_position(layout.start.x, layout.start.y, layout) %>">
        <span class="material-symbols-outlined">flag</span> Largada
      </span>
      <span class="map-flag is-finish" style="<%= map_position(layout.finish.x, layout.finish.y, layout) %>">
        <span class="material-symbols-outlined">sports_score</span> Chegada
      </span>

      <% layout.nodes.each do |node| %>
        <% maneuver = node.maneuver %>
        <span class="map-decoration material-symbols-outlined <%= "is-tree" if node.decoration[:tree] %>"
              style="<%= map_position(node.decoration[:x], node.point.y, layout) %>" aria-hidden="true"><%= node.decoration[:icon] %></span>

        <% status = progression.status_for(maneuver) %>
        <% current = (maneuver == @current_maneuver) %>
        <%# Check só para o que foi concluído; liberado ou pulado = cadeado aberto. %>
        <% state = if status == "completed" then "is-completed"
                   elsif current then "is-current"
                   elsif status != "locked" then "is-open"
                   end %>

        <%= link_to maneuver_path(maneuver), class: ["map-node", state], style: map_position(node.point.x, node.point.y, layout),
                    title: maneuver.label, aria: { label: maneuver.label },
                    data: ({ track_map_target: "current" } if current) do %>
          <% if status == "completed" %>
            <span class="material-symbols-outlined map-node-icon">check</span>
          <% elsif current %>
            <span class="material-symbols-outlined map-node-icon">play_arrow</span>
          <% elsif status == "locked" %>
            <span class="material-symbols-outlined map-node-icon">lock</span>
          <% else %>
            <span class="material-symbols-outlined map-node-icon">lock_open</span>
          <% end %>
          <span class="map-node-label is-<%= node.label_side %>"><%= maneuver.code %> · <%= maneuver.name %></span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<% if @current_maneuver %>
  <div class="floating-lesson-card" style="position: relative; flex-shrink: 0; margin-top: 10px; background: #1a1b20; border: 2px solid #343538; border-radius: 12px; padding: 14px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 8px 24px rgba(0,0,0,0.8); z-index: 20;">
    <div class="lesson-info" style="flex: 1; padding-right: 10px;">
      <span class="lesson-step" style="font-family: 'Inter', sans-serif; font-size: 9px; font-weight: 800; color: #ffb800; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
        MÓDULO ATUAL • <%= @current_maneuver.label %>
      </span>
      <h4 class="lesson-name" style="font-family: 'Outfit', sans-serif; font-size: 15px; font-weight: 900; color: #e3e2e6; margin: 0; line-height: 1.2;">
        <%= @current_maneuver.description.truncate(45) %>
      </h4>
    </div>
    <%= link_to maneuver_path(@current_maneuver), class: "tactile-btn-primary", style: "padding: 10px 14px; font-size: 12px; width: auto; font-family: 'Outfit', sans-serif; display: flex; align-items: center; gap: 4px; text-decoration: none;" do %>
      <span style="font-weight: 800;">Treinar</span>
      <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
    <% end %>
  </div>
<% end %>
