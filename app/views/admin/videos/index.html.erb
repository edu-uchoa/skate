<% content_for :section, "Painel" %>

<section class="zine-screen">
  <header class="auth-head">
    <span class="step-indicator">Super administrador</span>
    <h2 class="screen-title">Vídeos</h2>
    <p class="screen-desc">
      Todos os vídeos do app, de aprendizes, mentores e administradores. Apagar tira o
      vídeo do servidor na hora; o progresso na trilha e a devolutiva já enviada continuam.
    </p>
  </header>

  <%= render "admin/tabs", current: "videos" %>

  <h3 class="guide-card-label">Mais novos (<%= @videos.size %>)</h3>

  <% if @videos.empty? %>
    <div class="zine-empty">
      <span class="material-symbols-outlined auth-icon">videocam_off</span>
      <p>Nenhum vídeo no app.</p>
    </div>
  <% else %>
    <ol class="mentor-learners">
      <% @videos.each do |video| %>
        <li class="auth-card" id="<%= dom_id(video, :admin) %>">
          <span class="auth-card-label"><%= video.maneuver.label %> · <%= admin_time(video.clip.blob.created_at) %></span>
          <span class="auth-card-value"><%= admin_user_name(video.user) %></span>
          <span class="auth-hint">
            <%= admin_role_label(video.user) %> ·
            <%= video.ai_review&.status_completed? ? "com devolutiva" : "esperando o mentor" %>
          </span>

          <details class="admin-video">
            <summary class="auth-link">Assistir</summary>
            <%# preload none: o vídeo só baixa (e só entra em "quem assistiu") se você der play. %>
            <%= training_video_tag(video, class: "admin-video-player", preload: "none") %>
          </details>

          <%= button_to "Apagar vídeo", admin_video_path(video), method: :delete, class: "auth-secondary-btn danger",
                form: { data: { turbo_confirm: "Apagar este vídeo de #{admin_user_name(video.user)}? Ninguém mais vai conseguir ver." } } %>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>
